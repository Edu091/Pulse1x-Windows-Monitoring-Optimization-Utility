<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\pulse1x.ico</ApplicationIcon>
    <!-- Baseline local; a Release do GitHub Actions sobrescreve via -p:Version=X.Y.Z (mesmo
         número da tag), para o GitHubUpdateService comparar a versão em execução com a mais
         recente publicada. IMPORTANTE: manter esta baseline igual (ou maior) à última tag
         publicada — builds locais (staging/atualizar_pulse1x.bat) nunca passam -p:Version, então
         se ficar desatualizada, a cópia sincronizada pelo SelfUpdateService no atalho de uso
         diário sempre vai parecer "mais antiga" que o Release do GitHub e o app vai pedir
         atualização sem necessidade a cada abertura (bug corrigido em 2026-07-13: baseline
         estava presa em 1.0.0 enquanto o Release já publicado era 1.0.1). -->
    <Version>1.13.2</Version>
  </PropertyGroup>

  <!-- O histórico de versões viaja dentro do executável, para a seção Sobre exibi-lo sem
       depender de internet nem de um arquivo ao lado do .exe (a publicação é single-file). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" LogicalName="Pulse1x.App.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore" Version="2.0.4" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <!-- Páginas de código legadas (CP850/CP437 etc.): o powercfg e o netsh escrevem a saída na
         página do console, não em UTF-8. Sem isto, nomes com acento ("Desempenho Máximo") chegam
         corrompidos e as comparações de texto falham. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- O TraceEvent (medição de FPS por ETW) traz DLLs nativas auxiliares — KernelTraceControl.dll
       e msdia140.dll — que só servem para símbolos, rundown do kernel e mesclagem de arquivos
       .etl. Uma sessão em tempo real de provedores de modo usuário, que é tudo o que o Pulse1x usa,
       não carrega nenhuma delas; tirá-las evita ~2,5 MB a mais no executável single-file. -->
  <Target Name="DropTraceEventHelperFiles" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.FullPath)').ToLowerInvariant().Contains('microsoft.diagnostics.tracing.traceevent'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Resources\pulse1x_taskbar.png" />
    <Resource Include="Resources\pulse1x_tray.ico" />
  </ItemGroup>

</Project>
