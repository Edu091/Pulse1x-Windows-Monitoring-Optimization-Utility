<UserControl
    x:Class="Pulse1x.App.Controls.GamepadKeyboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Focusable="False">

    <UserControl.Resources>
        <!-- Visual de cada tecla. O foco do controle acende a borda na cor de marca. -->
        <ControlTemplate x:Key="KeyTemplate" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="7"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#2A2C31" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                    <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!--
        Teclado virtual do GameHub, no estilo do Big Picture: uma grade de teclas navegável pelo
        direcional, onde A digita. Existe porque uma caixa de busca sem teclado físico é um beco sem
        saída para quem está no sofá com o controle.

        As teclas são criadas em código, dentro de painéis reais (não por ItemsControl com binding):
        assim os botões existem na árvore visual imediatamente e o foco do controle sempre encontra
        um destino — era justamente o container gerado sob demanda que fazia o foco "não entrar" no
        teclado e continuar mexendo nos jogos atrás.
    -->
    <Border CornerRadius="14" Padding="18" Background="#F20D0E11" BorderThickness="1" BorderBrush="#2A2C31">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="12" Opacity="0.75" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- Prévia do que está sendo digitado -->
            <Border CornerRadius="8" Background="#1C1D21" Padding="14,10" Margin="3,0,3,12">
                <TextBlock x:Name="PreviewText" Foreground="#F2F3F5" FontSize="17"
                           TextTrimming="CharacterEllipsis" MinHeight="22" />
            </Border>

            <!-- As linhas de teclas são preenchidas pelo code-behind. -->
            <StackPanel x:Name="KeyRows" HorizontalAlignment="Center" />

            <TextBlock x:Name="HintText" Foreground="#8B8F98" FontSize="11.5" HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
        </StackPanel>
    </Border>
</UserControl>
