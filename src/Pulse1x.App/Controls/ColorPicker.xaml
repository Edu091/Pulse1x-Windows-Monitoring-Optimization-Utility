<UserControl
    x:Class="Pulse1x.App.Controls.ColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <!--
        Seletor de cor visual: um quadrado de saturação/brilho, uma faixa de matiz e um campo
        hexadecimal. O usuário escolhe a cor com o mouse — o campo de texto continua existindo para
        quem quiser colar um código exato, mas nunca é obrigatório.
    -->
    <Border CornerRadius="10" Padding="12" BorderThickness="1"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <StackPanel>
            <!-- Quadrado de saturação (eixo X) e brilho (eixo Y) para a matiz atual -->
            <Border CornerRadius="6" ClipToBounds="True" Height="132" Margin="0,0,0,10">
                <Grid x:Name="ShadeArea" MouseLeftButtonDown="ShadeArea_MouseDown"
                      MouseMove="ShadeArea_MouseMove" MouseLeftButtonUp="ShadeArea_MouseUp"
                      Cursor="Cross" Background="Transparent">
                    <!-- Base: branco → matiz pura, da esquerda para a direita -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FFFFFFFF" />
                                <GradientStop Offset="1" Color="{Binding HueColor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Sobreposição: transparente → preto, de cima para baixo -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#FF000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Alvo da seleção -->
                    <Ellipse x:Name="ShadeCursor" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                             HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="Black" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="ShadeCursorPosition" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>

            <!-- Faixa de matiz -->
            <Border CornerRadius="5" ClipToBounds="True" Height="20" Margin="0,0,0,10">
                <Grid x:Name="HueArea" MouseLeftButtonDown="HueArea_MouseDown"
                      MouseMove="HueArea_MouseMove" MouseLeftButtonUp="HueArea_MouseUp"
                      Cursor="Hand" Background="Transparent">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0.00" Color="#FFFF0000" />
                                <GradientStop Offset="0.17" Color="#FFFFFF00" />
                                <GradientStop Offset="0.33" Color="#FF00FF00" />
                                <GradientStop Offset="0.50" Color="#FF00FFFF" />
                                <GradientStop Offset="0.67" Color="#FF0000FF" />
                                <GradientStop Offset="0.83" Color="#FFFF00FF" />
                                <GradientStop Offset="1.00" Color="#FFFF0000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border x:Name="HueCursor" Width="5" CornerRadius="2" BorderThickness="2"
                            BorderBrush="White" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HueCursorPosition" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <!-- Amostra + campo hexadecimal -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Border.Background>
                </Border>
                <ui:TextBox x:Name="HexBox" Grid.Column="1" VerticalAlignment="Center"
                            MaxLength="9" LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown" />
            </Grid>

            <!-- Atalhos: cores prontas + a cor de marca do Pulse1x -->
            <ItemsControl x:Name="PresetList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="24" Height="24" Margin="0,0,6,6" Cursor="Hand"
                                Click="Preset_Click" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Swatch" CornerRadius="12" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding}" />
                                        </Border.Background>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Swatch" Property="BorderBrush" Value="White" />
                                            <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
