<UserControl
    x:Class="Pulse1x.App.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <Border
        x:Name="CardBorder"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="14"
        Margin="6"
        Cursor="Hand"
        ToolTip="Clique para ver detalhes"
        MouseLeftButtonUp="CardBorder_MouseLeftButtonUp">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="CardBorderBrush" Color="#33808080" />
        </Border.BorderBrush>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation
                            Storyboard.TargetName="CardBorderBrush"
                            Storyboard.TargetProperty="Color"
                            To="White"
                            Duration="0:0:0.12" />
                        <DoubleAnimation
                            Storyboard.TargetName="HoverDim"
                            Storyboard.TargetProperty="Opacity"
                            To="0.08"
                            Duration="0:0:0.12" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Border.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation
                            Storyboard.TargetName="CardBorderBrush"
                            Storyboard.TargetProperty="Color"
                            To="#33808080"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="HoverDim"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="30"
                        Height="30"
                        CornerRadius="8"
                        Background="{Binding BadgeBrush, ElementName=Root}"
                        Margin="0,0,10,0">
                        <TextBlock
                            Text="{Binding Badge, ElementName=Root}"
                            Foreground="White"
                            FontSize="10"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Title, ElementName=Root}"
                        FontSize="13"
                        Opacity="0.75"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <Ellipse
                        Grid.Column="2"
                        Width="9"
                        Height="9"
                        VerticalAlignment="Center"
                        Fill="{Binding LevelBrush, ElementName=Root}" />
                </Grid>

                <TextBlock Text="{Binding PrimaryValue, ElementName=Root}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SecondaryValue, ElementName=Root}" FontSize="12" Opacity="0.6" Margin="0,3,0,0" TextWrapping="Wrap" />

                <Border
                    x:Name="ProgressTrack"
                    Height="6"
                    CornerRadius="3"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Margin="0,12,0,0"
                    SizeChanged="ProgressTrack_SizeChanged"
                    Visibility="{Binding ProgressVisibility, ElementName=Root}">
                    <Border
                        x:Name="ProgressFill"
                        HorizontalAlignment="Left"
                        CornerRadius="3"
                        Background="{Binding LevelBrush, ElementName=Root}" />
                </Border>
            </StackPanel>

            <!-- Camada de esmaecimento leve exibida ao passar o mouse (sobe de 0 a 0.08 de opacidade). -->
            <Border
                x:Name="HoverDim"
                Background="Black"
                CornerRadius="10"
                Opacity="0"
                IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
