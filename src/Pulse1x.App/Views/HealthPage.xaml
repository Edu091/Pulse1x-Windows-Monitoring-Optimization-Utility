<Page
    x:Class="Pulse1x.App.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:anim="clr-namespace:Pulse1x.App.Services"
    xmlns:local="clr-namespace:Pulse1x.App.Views"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}"
    mc:Ignorable="d"
    Title="Saúde">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />

        <!-- Cartão de um componente avaliado (CPU, GPU, disco, etc.) -->
        <DataTemplate x:Key="ComponentCard">
            <Border Margin="0,0,0,10" CornerRadius="12" BorderThickness="1" Padding="16" anim:Anim.PopOnLoad="True"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="8" Padding="12,6" VerticalAlignment="Center"
                                Background="{Binding RatingColor, Converter={StaticResource StrToBrush}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ScoreText}" Foreground="White" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RatingLabel}" Foreground="White" FontSize="10" Opacity="0.9"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Métricas detalhadas -->
                    <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.7" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Cartão de disco, no estilo CrystalDiskInfo: faixa de status + tabela de atributos SMART -->
        <DataTemplate x:Key="DiskHealthCard">
            <Border Margin="0,0,0,10" CornerRadius="12" BorderThickness="1" Padding="0" anim:Anim.PopOnLoad="True"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <!-- Faixa de status com a cor da classificação (Bom/Atenção/Crítico) -->
                    <Border CornerRadius="11,11,0,0" Padding="16,12"
                            Background="{Binding RatingColor, Converter={StaticResource StrToBrush}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Summary}" Foreground="White" Opacity="0.85" FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding RatingLabel}" Foreground="White" FontWeight="Bold" FontSize="18"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ScoreText}" Foreground="White" Opacity="0.85" FontSize="11"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Informações gerais do disco -->
                    <ItemsControl ItemsSource="{Binding Metrics}" Margin="16,12,16,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.7" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tabela de atributos SMART, no estilo CrystalDiskInfo -->
                    <Border Margin="16,4,16,16" CornerRadius="8" Padding="4,2"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <ItemsControl ItemsSource="{Binding SmartAttributes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,6,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Margin="0,0,10,0"
                                                Background="{Binding StatusColor, Converter={StaticResource StrToBrush}}">
                                            <TextBlock Text="{Binding StatusIcon}" Foreground="White" FontSize="10"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:HealthComponentTemplateSelector x:Key="ComponentTemplateSelector"
                                                ComponentCard="{StaticResource ComponentCard}"
                                                DiskHealthCard="{StaticResource DiskHealthCard}" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- Título da categoria -->
            <StackPanel Orientation="Horizontal" Margin="6,0,0,2">
                <ui:SymbolIcon Symbol="Heart24" Foreground="#DC2626" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding [Health_Title], Source={x:Static loc:Loc.Instance}}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding [Health_Subtitle], Source={x:Static loc:Loc.Instance}}"
                       Opacity="0.6" FontSize="13" Margin="6,0,0,16" />

            <!-- ===================== Cartão: Diagnóstico Inteligente ===================== -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="6,0,6,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BrandAccentBrush}">
                            <TextBlock Text="🩺" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Health_SmartDiagnostic], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [Health_SmartDiagnosticSub], Source={x:Static loc:Loc.Instance}}"
                                       Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Introdução / botão inicial -->
                    <StackPanel Visibility="{Binding ShowIntro, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" Opacity="0.8" LineHeight="20" Margin="0,0,0,12"
                                   Text="{Binding [Health_Intro], Source={x:Static loc:Loc.Instance}}" />
                        <ui:Button Content="{Binding [Health_StartDiagnostic], Source={x:Static loc:Loc.Instance}}" Command="{Binding RunDiagnosticCommand}"
                                   Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" Padding="18,8" />
                    </StackPanel>

                    <!-- Em andamento -->
                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" />
                            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Resultado ===================== -->
            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">

                <!-- Nota geral -->
                <Border CornerRadius="12" Padding="20" Margin="6,0,6,12"
                        Background="{Binding Report.OverallColor, Converter={StaticResource StrToBrush}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Health_OverallTitle], Source={x:Static loc:Loc.Instance}}" Foreground="White" Opacity="0.85" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Report.OverallRatingLabel}" Foreground="White" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="{Binding Report.GeneratedAtText}" Foreground="White" Opacity="0.8" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Report.OverallScoreText}" Foreground="White"
                                   FontSize="40" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <!-- Encolhe a análise detalhada, mantendo só este resumo visível -->
                        <ui:Button Grid.Column="2" Content="{Binding [Health_Collapse], Source={x:Static loc:Loc.Instance}}" Command="{Binding ToggleReportCollapsedCommand}"
                                   Background="#22FFFFFF" Foreground="White" BorderThickness="0"
                                   VerticalAlignment="Center" Padding="10,6"
                                   Visibility="{Binding IsReportCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding [Health_Expand], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Margin="6,0,6,12"
                           Cursor="Hand" Opacity="0.7">
                    <TextBlock.Visibility>
                        <Binding Path="IsReportCollapsed" Converter="{StaticResource BoolToVis}" />
                    </TextBlock.Visibility>
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleReportCollapsedCommand}" />
                    </TextBlock.InputBindings>
                </TextBlock>

                <StackPanel Visibility="{Binding IsReportCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">

                <!-- Notas por componente -->
                <TextBlock Text="{Binding [Health_Components], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,4,0,8" />
                <ItemsControl ItemsSource="{Binding Report.Components}"
                              ItemTemplateSelector="{StaticResource ComponentTemplateSelector}"
                              Margin="6,0,6,4" />

                <!-- Problemas detectados -->
                <TextBlock Text="{Binding [Health_Problems], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,12,0,8" />
                <Border CornerRadius="12" Padding="16" Margin="6,0,6,4" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Health_NoProblems], Source={x:Static loc:Loc.Instance}}" Opacity="0.8"
                                   Visibility="{Binding Report.HasNoProblems, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Report.Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Display}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{Binding SeverityColor, Converter={StaticResource StrToBrush}}">
                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recomendações -->
                <TextBlock Text="{Binding [Health_Recommendations], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,12,0,8" />
                <Border CornerRadius="12" Padding="16" Margin="6,0,6,4" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ItemsControl ItemsSource="{Binding Report.Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,4,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Riscos -->
                <TextBlock Text="{Binding [Health_Risks], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,12,0,8" />
                <Border CornerRadius="12" Padding="16" Margin="6,0,6,4" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ItemsControl ItemsSource="{Binding Report.Risks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center"
                                            Background="{Binding LevelColor, Converter={StaticResource StrToBrush}}">
                                        <TextBlock Text="{Binding LevelLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Relatório / exportação -->
                <TextBlock Text="{Binding [Health_Report], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,12,0,8" />
                <Border CornerRadius="12" Padding="16" Margin="6,0,6,4" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Health_ReportDesc], Source={x:Static loc:Loc.Instance}}"
                                   Opacity="0.7" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="📄  TXT" Command="{Binding ExportTxtCommand}" Margin="0,0,8,0" Padding="14,6" />
                            <ui:Button Content="🖨  PDF" Command="{Binding ExportPdfCommand}" Margin="0,0,8,0" Padding="14,6" />
                            <ui:Button Content="🧩  JSON" Command="{Binding ExportJsonCommand}" Padding="14,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ações -->
                <TextBlock Text="{Binding [Health_Actions], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,12,0,8" />
                <Border CornerRadius="12" Padding="16" Margin="6,0,6,4" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <WrapPanel>
                            <ui:Button Content="{Binding [Health_Reanalyze], Source={x:Static loc:Loc.Instance}}" Command="{Binding RunDiagnosticCommand}"
                                       Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_FixAuto], Source={x:Static loc:Loc.Instance}}" Command="{Binding FixAutomaticallyCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_OpenOptimizations], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenOptimizationsCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_WindowsTools], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenWindowsToolsCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_RunSfc], Source={x:Static loc:Loc.Instance}}" Command="{Binding RunSfcCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_RunDism], Source={x:Static loc:Loc.Instance}}" Command="{Binding RunDismCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_ClearTemp], Source={x:Static loc:Loc.Instance}}" Command="{Binding ClearTempFilesCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                            <ui:Button Content="{Binding [Health_ManageStartup], Source={x:Static loc:Loc.Instance}}" Command="{Binding ManageStartupCommand}"
                                       Margin="0,0,8,8" Padding="14,7" />
                        </WrapPanel>

                        <!-- Estado das ações -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding IsActionRunning, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" />
                            <TextBlock Text="{Binding [Common_Running], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding ActionStatus, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Border>

                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
