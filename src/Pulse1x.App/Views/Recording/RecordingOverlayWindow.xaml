<Window
    x:Class="Pulse1x.App.Views.Recording.RecordingOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    Title="Pulse1x"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    Left="-10000" Top="0" Width="800" Height="600"
    Foreground="White"
    FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />

        <Style x:Key="Widget" TargetType="Border">
            <Setter Property="Background" Value="#F01B1B1F" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="WidgetTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Botão redondo do widget de captura -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="26" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fundo escurecido: clicar fora dos widgets fecha o menu -->
        <Border x:Name="Backdrop" Background="#99000000" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" />

        <!-- Barra superior -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="18,8"
                CornerRadius="12" Background="#F01B1B1F" BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Pulse1x.App;component/Resources/pulse1x_taskbar.png" Width="20" Height="20" Margin="0,0,10,0" />
                <TextBlock Text="Pulse1x" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Width="1" Background="#33FFFFFF" Margin="14,2" />
                <TextBlock x:Name="ClockText" VerticalAlignment="Center" Opacity="0.85" />
                <Border Width="1" Background="#33FFFFFF" Margin="14,2" />
                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenAppCommand}" Margin="0,0,6,0" Padding="10,4"
                        ToolTip="{Binding [Rec_OverlayOpenApp], Source={x:Static loc:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenGameBarCommand}" Margin="0,0,6,0" Padding="10,4"
                        ToolTip="{Binding [Rec_OverlayGameBar], Source={x:Static loc:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="XboxController24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="Close_Click" Margin="0" Padding="10,4"
                        ToolTip="{Binding [Rec_OverlayClose], Source={x:Static loc:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Widgets -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,96,0,0">

            <!-- Captura -->
            <Border Style="{StaticResource Widget}" Width="360">
                <StackPanel>
                    <TextBlock Text="{Binding [Rec_OverlayCapture], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource WidgetTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="10" Height="10" Fill="{Binding StateColor, Converter={StaticResource StrToBrush}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="14,0,0,0"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <!-- Gravar / Parar -->
                        <Button Command="{Binding StartStopCommand}" Background="#DC2626"
                                ToolTip="{Binding MainButtonText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RoundButton}" />
                            </Button.Style>
                            <Grid>
                                <Ellipse Width="18" Height="18" Fill="White" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="White" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <!-- Pausar / Continuar -->
                        <Button Style="{StaticResource RoundButton}" Command="{Binding PauseResumeCommand}" ToolTip="{Binding PauseButtonText}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Pause24" FontSize="22" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <ui:SymbolIcon Symbol="Play24" FontSize="22" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <!-- Mudo do microfone (só quando a gravação tem microfone) -->
                        <ToggleButton IsChecked="{Binding MicMuted}" Width="52" Height="52" Margin="0,0,10,0" Cursor="Hand"
                                      ToolTip="{Binding [Rec_OverlayMicMute], Source={x:Static loc:Loc.Instance}}"
                                      Visibility="{Binding HasMicrophoneTrack, Converter={StaticResource BoolToVis}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" CornerRadius="26" Background="#33FFFFFF">
                                        <ui:SymbolIcon x:Name="Icon" Symbol="Mic24" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EAB308" />
                                            <Setter TargetName="Icon" Property="Symbol" Value="MicOff24" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- Pasta -->
                        <Button Style="{StaticResource RoundButton}" Command="{Binding OpenFolderCommand}"
                                ToolTip="{Binding [Rec_OpenFolder], Source={x:Static loc:Loc.Instance}}">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="22" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding ActiveInfo}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding ActiveInfo, Converter={StaticResource StrToVis}}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FBBF24"
                               Visibility="{Binding StatusText, Converter={StaticResource StrToVis}}" />
                    <TextBlock x:Name="HotkeyHint" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Gravações recentes -->
            <Border Style="{StaticResource Widget}" Width="360">
                <StackPanel>
                    <TextBlock Text="{Binding [Rec_RecentTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource WidgetTitle}" />
                    <TextBlock Text="{Binding [Rec_RecentEmpty], Source={x:Static loc:Loc.Instance}}" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding RecentThree}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,0,8" Padding="6" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <Grid Width="320">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="54" CornerRadius="6" Background="#40000000" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border Background="#B0000000" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"
                                                        Visibility="{Binding DurationText, Converter={StaticResource StrToVis}}">
                                                    <TextBlock Text="{Binding DurationText}" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Opacity="0.6">
                                                <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding OpenAppCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Content="{Binding [Rec_OverlaySeeAll], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
