<Page
    x:Class="Pulse1x.App.Views.LatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Pulse1x.App.Controls"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:anim="clr-namespace:Pulse1x.App.Services"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:LatencyViewModel}"
    mc:Ignorable="d"
    Title="Latência">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />

        <!-- Tile de métrica do painel em tempo real -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Width" Value="158" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Card de ferramenta (ação pontual / tweak / perfil) -->
        <DataTemplate x:Key="ToolCard" DataType="{x:Type vm:NetworkToolViewModel}">
            <Border Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" Padding="10"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <ui:Button Content="{Binding [Lat_Apply], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding RunCommand}" Padding="14,6"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Linha de servidor de teste -->
        <DataTemplate x:Key="TestServerRow" DataType="{x:Type vm:TestServerViewModel}">
            <Border Margin="0,0,0,5" CornerRadius="8" BorderThickness="1" Padding="10,8" anim:Anim.PopOnLoad="True"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0"
                             Fill="{Binding Color, Converter={StaticResource StrToBrush}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Host}" FontSize="11" Opacity="0.55" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0" MinWidth="64">
                        <TextBlock Text="{Binding [Lat_Ping], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{Binding PingText}" FontWeight="SemiBold"
                                   Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0" MinWidth="64">
                        <TextBlock Text="{Binding [Lat_Jitter], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{Binding JitterText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0" MinWidth="56">
                        <TextBlock Text="{Binding [Lat_Loss], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{Binding LossText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Linha do diagnóstico -->
        <DataTemplate x:Key="DiagnosticRow" DataType="{x:Type vm:DiagnosticLineViewModel}">
            <Grid Margin="0,0,0,6" anim:Anim.PopOnLoad="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <!-- Título -->
            <TextBlock Text="{Binding [Lat_Title], Source={x:Static loc:Loc.Instance}}" FontSize="20" FontWeight="Bold" Margin="6,0,0,2" />
            <TextBlock Text="{Binding [Lat_Subtitle], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="13" Margin="6,0,0,14" TextWrapping="Wrap" />

            <!-- Nota geral da conexão -->
            <Border CornerRadius="12" Padding="18,14" Margin="6,0,6,16" BorderThickness="1"
                    BorderBrush="{Binding ScoreColor, Converter={StaticResource StrToBrush}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding [Lat_Connection], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.65" />
                        <TextBlock Text="{Binding ScoreText}" FontSize="34" FontWeight="Bold"
                                   Foreground="{Binding ScoreColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreRatingText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Lat_ScoreHint], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="{Binding [Lat_Measure], Source={x:Static loc:Loc.Instance}}"
                               Command="{Binding RefreshScoreCommand}" />
                </Grid>
            </Border>

            <!-- ===================== Painel em tempo real ===================== -->
            <TextBlock Text="{Binding [Lat_LivePanel], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="6,0,0,8" />
            <WrapPanel Margin="0,0,0,8">
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Ping], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding PingColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding PingText}" Style="{StaticResource TileValue}"
                                   Foreground="{Binding PingColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Jitter], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding JitterColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding JitterText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Loss], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding LossColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding LossText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Download], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding DownloadText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Upload], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding UploadText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_LinkSpeed], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding LinkSpeedText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Signal], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding SignalColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding SignalText}" Style="{StaticResource TileValue}" FontSize="15"
                                   Foreground="{Binding SignalColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Band], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding BandText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Channel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding ChannelText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Ssid], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding SsidText}" Style="{StaticResource TileValue}" FontSize="15" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Dns], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding DnsText}" Style="{StaticResource TileValue}" FontSize="14" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_LocalIp], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding IpText}" Style="{StaticResource TileValue}" FontSize="14" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Gráficos -->
            <WrapPanel Margin="0,0,0,8">
                <controls:LiveChart Width="330" Title="{Binding [Lat_ChartDownload], Source={x:Static loc:Loc.Instance}}" Values="{Binding DownloadChart}" AccentColor="#22C55E" />
                <controls:LiveChart Width="330" Title="{Binding [Lat_ChartUpload], Source={x:Static loc:Loc.Instance}}" Values="{Binding UploadChart}" AccentColor="#F59E0B" />
                <controls:LiveChart Width="330" Title="{Binding [Lat_ChartPing], Source={x:Static loc:Loc.Instance}}" Values="{Binding PingChart}" AccentColor="#DC2626" />
            </WrapPanel>

            <!-- ===================== Diagnóstico inteligente ===================== -->
            <Border CornerRadius="12" Padding="16" Margin="6,8,6,16" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding [Lat_DiagTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"
                                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                       Content="{Binding [Lat_Analyze], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding AnalyzeCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DiagnosticHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"
                               Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding DiagnosticLines}" ItemTemplate="{StaticResource DiagnosticRow}"
                                  Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ===================== Verificação de latência de drivers ===================== -->
            <Border CornerRadius="12" Padding="16" Margin="6,0,6,16" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding [Lat_DrvTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [Lat_DrvSubtitle], Source={x:Static loc:Loc.Instance}}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"
                                             Visibility="{Binding IsCheckingDriverLatency, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                       Content="{Binding [Lat_DrvCheck], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding CheckDriverLatencyCommand}"
                                       IsEnabled="{Binding IsCheckingDriverLatency, Converter={StaticResource InvBool}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DriverLatencyHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"
                               Foreground="{Binding DriverLatencyColor, Converter={StaticResource StrToBrush}}"
                               Visibility="{Binding HasDriverLatencyResult, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding DriverLatencyLines}" ItemTemplate="{StaticResource DiagnosticRow}"
                                  Visibility="{Binding HasDriverLatencyResult, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ===================== Servidores de teste ===================== -->
            <Grid Margin="6,0,6,8">
                <TextBlock Text="{Binding [Lat_TestServers], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                     Visibility="{Binding IsTestingServers, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="{Binding [Lat_TestNow], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestServersCommand}" />
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding TestServers}" ItemTemplate="{StaticResource TestServerRow}" Margin="6,0,6,16" />

            <!-- ===================== Otimizações e ferramentas ===================== -->
            <Border CornerRadius="12" Padding="16" Margin="6,0,6,16" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding [Lat_ToolsTitle], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" />

                    <Grid Margin="0,12,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                       Content="{Binding [Lat_ApplyAll], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding ApplyAllCommand}" IsEnabled="{Binding IsApplyingAll, Converter={StaticResource InvBool}}" />
                            <ui:Button Content="{Binding [Lat_RestoreAll], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding RestoreAllCommand}" Margin="8,0,0,0"
                                       Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}" />
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsApplyingAll, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ApplyAllStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding ApplyAllStatus, Converter={StaticResource BoolToVis}}" />

                    <!-- DNS -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="10" Margin="0,8,0,12"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_ToolDns], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [Lat_ToolDnsDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="160" Margin="10,0,8,0"
                                      ItemsSource="{Binding DnsOptions}" SelectedIndex="{Binding SelectedDnsIndex, Mode=TwoWay}" />
                            <ui:Button Grid.Column="3" VerticalAlignment="Center"
                                       Content="{Binding [Lat_Apply], Source={x:Static loc:Loc.Instance}}" Command="{Binding ApplyDnsCommand}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [Lat_GroupActions], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_GroupTweaks], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,6" />
                    <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_GroupProfiles], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,6" />
                    <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_ReversibleNote], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
