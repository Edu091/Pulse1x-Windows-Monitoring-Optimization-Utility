<Page
    x:Class="Pulse1x.App.Views.LatencyPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Pulse1x.App.Controls"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:anim="clr-namespace:Pulse1x.App.Services"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:LatencyViewModel}"
    mc:Ignorable="d"
    Title="Latência">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />

        <!-- Cartão de seção (todas as áreas recolhíveis usam o mesmo visual) -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6,0,6,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <!-- Subcartão dentro de uma seção (teste/ajuste individual) -->
        <Style x:Key="SubCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>
        <Style x:Key="Chevron" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,2,0" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Tile de métrica do painel em tempo real -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <!-- Margem 6: bordas externas da grade alinhadas às dos cartões de seção. -->
            <Setter Property="Margin" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!-- Valores longos (DNS, SSID, IP) são cortados; o texto completo aparece ao passar o mouse. -->
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- Card de ferramenta (ação pontual / tweak / perfil) -->
        <DataTemplate x:Key="ToolCard" DataType="{x:Type vm:NetworkToolViewModel}">
            <Border Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" Padding="10"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <!-- Selo "Ativo": o ajuste está aplicado pelo Pulse1x e o "Reverter" o desfaz. -->
                            <Border CornerRadius="4" Padding="6,1" Background="#2622C55E" VerticalAlignment="Center"
                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [Lat_ActiveBadge], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <!-- Largura mínima fixa: o card não "pula" quando o botão vira o anel de progresso. -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="84">
                        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <ui:Button Content="{Binding ButtonText}" HorizontalAlignment="Stretch"
                                       Command="{Binding RunCommand}" Padding="14,6" />
                            <!-- Reverter: só aparece quando este ajuste tem alterações ativas. -->
                            <ui:Button HorizontalAlignment="Stretch" Margin="0,6,0,0" Padding="14,6"
                                       Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Content="{Binding [Lat_Revert], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding RevertCommand}"
                                       Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Linha de servidor de teste -->
        <DataTemplate x:Key="TestServerRow" DataType="{x:Type vm:TestServerViewModel}">
            <Border Margin="0,0,0,5" CornerRadius="8" BorderThickness="1" Padding="10,8" anim:Anim.PopOnLoad="True"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0"
                             Fill="{Binding Color, Converter={StaticResource StrToBrush}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Host}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0" MinWidth="64">
                        <TextBlock Text="{Binding [Lat_Ping], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{Binding PingText}" FontWeight="SemiBold"
                                   Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0" MinWidth="64">
                        <TextBlock Text="{Binding [Lat_Jitter], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{Binding JitterText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0" MinWidth="56">
                        <TextBlock Text="{Binding [Lat_Loss], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.5" />
                        <TextBlock Text="{Binding LossText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Linha de rede Wi-Fi vizinha -->
        <DataTemplate x:Key="WifiNetworkRow" DataType="{x:Type vm:WifiNetworkViewModel}">
            <Border x:Name="Row" Margin="0,0,0,4" CornerRadius="8" BorderThickness="1" Padding="10,7" anim:Anim.PopOnLoad="True"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            <Border CornerRadius="4" Padding="6,0" Margin="8,0,0,0" Background="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [Lat_WifiYou], Source={x:Static loc:Loc.Instance}}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,0" Margin="8,0,0,0" Background="#33F97316" VerticalAlignment="Center"
                                    Visibility="{Binding Interferes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [Lat_WifiInterferes], Source={x:Static loc:Loc.Instance}}" FontSize="10" Foreground="#F97316" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Barra de sinal -->
                    <Grid Grid.Column="1" Width="50" Height="6" VerticalAlignment="Center" Margin="10,0">
                        <Border CornerRadius="3" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Border CornerRadius="3" HorizontalAlignment="Left" Width="{Binding SignalBarWidth}"
                                Background="{Binding Color, Converter={StaticResource StrToBrush}}" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding SignalText}" FontWeight="SemiBold" MinWidth="36" TextAlignment="Right"
                               VerticalAlignment="Center" Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha do benchmark de DNS -->
        <DataTemplate x:Key="DnsResultRow" DataType="{x:Type vm:DnsResultViewModel}">
            <Grid Margin="0,0,0,6" anim:Anim.PopOnLoad="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Address}" FontSize="11" Opacity="0.55" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Margin="8,0" VerticalAlignment="Center" Background="#2622C55E"
                        Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [Lat_DnsFastestBadge], Source={x:Static loc:Loc.Instance}}" FontSize="11" Foreground="#22C55E" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontWeight="SemiBold" MinWidth="56" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
            </Grid>
        </DataTemplate>

        <!-- Linha de um serviço dentro do cartão da empresa (Status dos Servidores) -->
        <DataTemplate x:Key="ServiceStatusRow" DataType="{x:Type vm:ServiceStatusViewModel}">
            <ui:Button HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                       Background="Transparent" BorderThickness="0" Padding="6,5" Margin="0,0,0,1"
                       Command="{Binding ShowDetailCommand}" Cursor="Hand" anim:Anim.PopOnLoad="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
                </Grid>
            </ui:Button>
        </DataTemplate>

        <!-- Cartão expansível de uma empresa monitorada (Status dos Servidores) -->
        <DataTemplate x:Key="CompanyStatusCard" DataType="{x:Type vm:CompanyStatusViewModel}">
            <Border Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" Padding="4" anim:Anim.PopOnLoad="True"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0"
                                  HorizontalContentAlignment="Stretch" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center" Margin="2,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding OverallEmoji}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding OverallLabel}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{Binding OverallColor, Converter={StaticResource StrToBrush}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,10,0" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ServiceCountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding [Srv_ServicesLabel], Source={x:Static loc:Loc.Instance}}" FontSize="10" Opacity="0.55" HorizontalAlignment="Right" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="3" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="3" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>

                    <!-- Incidente ativo (uma linha) — visível mesmo com o cartão recolhido -->
                    <Border CornerRadius="6" Padding="8,5" Margin="8,2,8,2" Background="#33DC2626"
                            Visibility="{Binding HasIncident, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding IncidentSummary}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="4,2,4,4"
                                anim:Anim.AnimateVisibility="True" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceStatusRow}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Linha do diagnóstico -->
        <DataTemplate x:Key="DiagnosticRow" DataType="{x:Type vm:DiagnosticLineViewModel}">
            <Grid Margin="0,0,0,6" anim:Anim.PopOnLoad="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="684" HorizontalAlignment="Left">

            <!-- Título -->
            <TextBlock Text="{Binding [Lat_Title], Source={x:Static loc:Loc.Instance}}" FontSize="20" FontWeight="Bold" Margin="6,0,0,2" />
            <TextBlock Text="{Binding [Lat_Subtitle], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="13" Margin="6,0,0,14" TextWrapping="Wrap" />

            <!-- Input Lab vem primeiro: mede a latencia da entrada antes das ferramentas de rede. -->
            <!-- HorizontalAlignment explícito: o estilo de Button do Wpf.Ui encolhia o card ao conteúdo. -->
            <Button Click="InputLab_Click" Margin="6,0,6,16" Padding="0" BorderThickness="0"
                    Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InputLabCard" CornerRadius="8" Padding="16,14" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                        Background="#20F87171" Margin="0,0,13,0">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="22"
                                                   Foreground="{DynamicResource BrandAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [InputLab_Title], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [InputLab_EntryDescription], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="12" Opacity="0.62" TextWrapping="Wrap" Margin="0,2,12,0" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="18"
                                               Opacity="0.7" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputLabCard" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="InputLabCard" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputLabCard" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                                <Setter TargetName="InputLabCard" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nota geral da conexão -->
            <Border CornerRadius="12" Padding="18,14" Margin="6,0,6,16" BorderThickness="1"
                    BorderBrush="{Binding ScoreColor, Converter={StaticResource StrToBrush}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding [Lat_Connection], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.65" />
                        <TextBlock Text="{Binding ScoreText}" FontSize="34" FontWeight="Bold"
                                   Foreground="{Binding ScoreColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Bolinha desenhada: o WPF mostra os emojis 🟢🟡 em preto e branco (saía "⚪ Excelente"). -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ScoreRatingText, Converter={StaticResource StrToVis}}">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,1,8,0"
                                     Fill="{Binding ScoreColor, Converter={StaticResource StrToBrush}}" />
                            <TextBlock Text="{Binding ScoreRatingText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding [Lat_ScoreHint], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Content="{Binding [Lat_Measure], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding RefreshScoreCommand}"
                                   IsEnabled="{Binding IsMeasuringScore, Converter={StaticResource InvBool}}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                         Visibility="{Binding IsMeasuringScore, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===================== Painel em tempo real ===================== -->
            <ToggleButton IsChecked="{Binding LivePanelExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                          Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="6,4" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Lat_LivePanel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                   Visibility="{Binding LivePanelExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                   Visibility="{Binding LivePanelExpanded, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ToggleButton>
            <StackPanel anim:Anim.AnimateVisibility="True" Visibility="{Binding LivePanelExpanded, Converter={StaticResource BoolToVis}}">

            <!-- Windows 11 24H2+ esconde os dados do Wi-Fi sem a permissão de localização -->
            <Border CornerRadius="8" Padding="12,10" Margin="6,0,6,6" Background="#26F97316" BorderBrush="#66F97316" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsWifi}" Value="True" />
                                    <Condition Binding="{Binding WifiLocationBlocked}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Lat_WifiLocationBlocked], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                               Content="{Binding [Lat_OpenLocation], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenLocationSettingsCommand}" />
                </Grid>
            </Border>

            <!-- Grade de 4 colunas: os tiles esticam/encolhem com a janela (com WrapPanel e largura fixa
                 sobrava um vão à direita em janelas estreitas). Tiles recolhidos não ocupam célula. -->
            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricTile}" ToolTip="{Binding [Lat_PingInternetTip], Source={x:Static loc:Loc.Instance}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_PingInternet], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding PingColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding PingText}" Style="{StaticResource TileValue}"
                                   Foreground="{Binding PingColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}" ToolTip="{Binding [Lat_PingRouterTip], Source={x:Static loc:Loc.Instance}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_PingRouter], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding RouterPingColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding RouterPingText}" Style="{StaticResource TileValue}"
                                   Foreground="{Binding RouterPingColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Jitter], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding JitterColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding JitterText}" Style="{StaticResource TileValue}"
                                   Foreground="{Binding JitterColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Loss], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding LossColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding LossText}" Style="{StaticResource TileValue}"
                                   Foreground="{Binding LossColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Download], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding DownloadText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Upload], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding UploadText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_LinkSpeed], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding LinkSpeedText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Dns], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding DnsText}" Style="{StaticResource TileValue}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <!-- Só Wi-Fi: no cabo estes tiles mostravam "—" e ocupavam uma linha inteira à toa. -->
                <Border Style="{StaticResource MetricTile}" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding [Lat_Signal], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{Binding SignalColor, Converter={StaticResource StrToBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding SignalText}" Style="{StaticResource TileValue}" FontSize="15" Margin="0,5,0,0"
                                   Foreground="{Binding SignalColor, Converter={StaticResource StrToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_BandChannel], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding BandChannelText}" Style="{StaticResource TileValue}" FontSize="15" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Ssid], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding SsidText}" Style="{StaticResource TileValue}" FontSize="15" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_LocalIp], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding IpText}" Style="{StaticResource TileValue}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lat_Adapter], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding AdapterText}" Style="{StaticResource TileValue}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Gráficos: ping em largura total; download e upload lado a lado. Antes eram 330 px fixos:
                 o terceiro ficava sozinho numa linha e, em janelas estreitas, eram cortados à direita. -->
            <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:LiveChart Grid.ColumnSpan="2" Title="{Binding [Lat_ChartPing], Source={x:Static loc:Loc.Instance}}" Values="{Binding PingChart}" AccentColor="{DynamicResource BrandAccentColor}" />
                <controls:LiveChart Grid.Row="1" Title="{Binding [Lat_ChartDownload], Source={x:Static loc:Loc.Instance}}" Values="{Binding DownloadChart}" AccentColor="#22C55E" />
                <controls:LiveChart Grid.Row="1" Grid.Column="1" Title="{Binding [Lat_ChartUpload], Source={x:Static loc:Loc.Instance}}" Values="{Binding UploadChart}" AccentColor="#F59E0B" />
            </Grid>
            </StackPanel>

            <!-- ===================== Central de Wi-Fi ===================== -->
            <Border Style="{StaticResource SectionCard}" Margin="6,4,6,16"
                    Visibility="{Binding HasWifiAdapter, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding WifiExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_WifiTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Lat_WifiSubtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding WifiExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding WifiExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>

                    <StackPanel Margin="0,12,0,0" anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding WifiExpanded, Converter={StaticResource BoolToVis}}">

                        <!-- Modo partida: sem buscas em segundo plano -->
                        <Border Style="{StaticResource SubCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🎯" FontSize="20" VerticalAlignment="Center" Margin="2,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Lat_WifiGameMode], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [Lat_WifiGameModeDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    <TextBlock Text="{Binding WifiGameModeStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding WifiGameModeStatus, Converter={StaticResource StrToVis}}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                                                 IsChecked="{Binding WifiGameMode, Mode=TwoWay}"
                                                 IsEnabled="{Binding IsWifiGameModeBusy, Converter={StaticResource InvBool}}" />
                            </Grid>
                        </Border>

                        <!-- Varredura de redes e canais -->
                        <Border Style="{StaticResource SubCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [Lat_WifiScanTitle], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [Lat_WifiScanDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                                         Visibility="{Binding IsScanningWifi, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Wifi124}" Content="{Binding [Lat_WifiScan], Source={x:Static loc:Loc.Instance}}"
                                                   Command="{Binding ScanWifiCommand}"
                                                   IsEnabled="{Binding IsScanningWifi, Converter={StaticResource InvBool}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding WifiScanSummary}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding WifiScanSummary, Converter={StaticResource StrToVis}}" />
                                <StackPanel Visibility="{Binding HasWifiScan, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding WifiAdviceLines}" ItemTemplate="{StaticResource DiagnosticRow}" Margin="0,10,0,4" />
                                    <ItemsControl ItemsSource="{Binding WifiNetworks}" ItemTemplate="{StaticResource WifiNetworkRow}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [Lat_WifiDriverGroup], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource GroupLabel}" Margin="0,4,0,6" />
                        <ItemsControl ItemsSource="{Binding WifiTools}" ItemTemplate="{StaticResource ToolCard}" />
                        <TextBlock Text="{Binding [Lat_AdapterRestartNote], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Testes avançados ===================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding AdvancedTestsExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_AdvTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Lat_AdvSubtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding AdvancedTestsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding AdvancedTestsExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>

                    <StackPanel Margin="0,12,0,0" anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding AdvancedTestsExpanded, Converter={StaticResource BoolToVis}}">

                        <!-- Bufferbloat -->
                        <Border Style="{StaticResource SubCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [Lat_BbTitle], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [Lat_BbDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                                         Visibility="{Binding IsTestingBufferbloat, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button Content="{Binding [Lat_BbRun], Source={x:Static loc:Loc.Instance}}"
                                                   Command="{Binding TestBufferbloatCommand}"
                                                   IsEnabled="{Binding IsTestingBufferbloat, Converter={StaticResource InvBool}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding BufferbloatProgress}" FontSize="12" Opacity="0.75" Margin="0,8,0,0"
                                           Visibility="{Binding BufferbloatProgress, Converter={StaticResource StrToVis}}" />
                                <Grid Margin="0,12,0,0" Visibility="{Binding HasBufferbloat, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" CornerRadius="10" BorderThickness="2" VerticalAlignment="Top" Margin="0,0,14,0"
                                            BorderBrush="{Binding BufferbloatColor, Converter={StaticResource StrToBrush}}">
                                        <TextBlock Text="{Binding BufferbloatGrade}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding BufferbloatColor, Converter={StaticResource StrToBrush}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,3" Visibility="{Binding BufferbloatIdleText, Converter={StaticResource StrToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Lat_BbIdle], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.65" />
                                            <TextBlock Grid.Column="1" Text="{Binding BufferbloatIdleText}" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Margin="0,0,0,3" Visibility="{Binding BufferbloatDownText, Converter={StaticResource StrToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Lat_BbDownload], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.65" />
                                            <TextBlock Grid.Column="1" Text="{Binding BufferbloatDownText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6" Visibility="{Binding BufferbloatUpText, Converter={StaticResource StrToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Lat_BbUpload], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.65" />
                                            <TextBlock Grid.Column="1" Text="{Binding BufferbloatUpText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{Binding BufferbloatAdvice}" FontSize="12" TextWrapping="Wrap" LineHeight="17" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Benchmark de DNS -->
                        <Border Style="{StaticResource SubCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [Lat_DnsBenchTitle], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [Lat_DnsBenchDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                                         Visibility="{Binding IsBenchmarkingDns, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button Content="{Binding [Lat_DnsBenchRun], Source={x:Static loc:Loc.Instance}}"
                                                   Command="{Binding BenchmarkDnsCommand}"
                                                   IsEnabled="{Binding IsBenchmarkingDns, Converter={StaticResource InvBool}}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DnsResults}" ItemTemplate="{StaticResource DnsResultRow}" Margin="0,12,0,0" />
                                <Grid Margin="0,4,0,0" Visibility="{Binding DnsBenchStatus, Converter={StaticResource StrToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DnsBenchStatus}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource BrandAccentBrush}" Foreground="White"
                                               Content="{Binding [Lat_DnsUseFastest], Source={x:Static loc:Loc.Instance}}"
                                               Command="{Binding ApplyFastestDnsCommand}"
                                               IsEnabled="{Binding IsApplyingDns, Converter={StaticResource InvBool}}"
                                               Visibility="{Binding CanApplyFastestDns, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- MTU -->
                        <Border Style="{StaticResource SubCard}" Margin="0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [Lat_MtuTitle], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [Lat_MtuDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                                         Visibility="{Binding IsTestingMtu, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button Content="{Binding [Lat_MtuRun], Source={x:Static loc:Loc.Instance}}"
                                                   Command="{Binding TestMtuCommand}"
                                                   IsEnabled="{Binding IsTestingMtu, Converter={StaticResource InvBool}}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0" Visibility="{Binding MtuText, Converter={StaticResource StrToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MtuText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="1" Margin="10,0,0,0"
                                               Content="{Binding [Lat_MtuApply], Source={x:Static loc:Loc.Instance}}"
                                               Command="{Binding ApplyMtuCommand}"
                                               Visibility="{Binding CanApplyMtu, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Icon="{ui:SymbolIcon ArrowUndo24}"
                                           Content="{Binding [Lat_MtuRevert], Source={x:Static loc:Loc.Instance}}"
                                           Command="{Binding RevertMtuCommand}"
                                           Visibility="{Binding MtuCanRevert, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Status dos Servidores ===================== -->
            <Border Style="{StaticResource SectionCard}" DataContext="{Binding ServerStatus}">
                <StackPanel>
                    <!-- Cabeçalho recolhível: título + subtítulo + chevron -->
                    <ToggleButton IsChecked="{Binding IsSectionExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Srv_Title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Srv_Subtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding IsSectionExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding IsSectionExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>

                    <StackPanel Margin="0,12,0,0" anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding IsSectionExpanded, Converter={StaticResource BoolToVis}}">

                    <!-- Atualizar -->
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Content="{Binding [Srv_Refresh], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding RefreshCommand}" IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvBool}}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Barra de status: contadores + última atualização -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center">
                                <Run Text="{Binding MonitoredCompanyCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding [Srv_CompaniesWord], Source={x:Static loc:Loc.Instance}, Mode=OneWay}" />
                                <Run Text="·" Foreground="#808080" />
                                <Run Text="{Binding MonitoredServiceCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding [Srv_ServicesWord], Source={x:Static loc:Loc.Instance}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding [Srv_LastUpdate], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LastUpdateText}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Barra de pesquisa -->
                    <ui:TextBox Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,12"
                                PlaceholderText="{Binding [Srv_SearchPlaceholder], Source={x:Static loc:Loc.Instance}}"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Cartões das empresas -->
                    <ItemsControl ItemsSource="{Binding Companies}" ItemTemplate="{StaticResource CompanyStatusCard}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Diagnóstico inteligente ===================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding DiagnosticExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_DiagTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Lat_DiagSubtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding DiagnosticExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding DiagnosticExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>
                    <StackPanel Margin="0,12,0,0" anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding DiagnosticExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold"
                                       Content="{Binding [Lat_Analyze], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding AnalyzeCommand}"
                                       IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvBool}}" />
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiagnosticHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"
                                   Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding DiagnosticLines}" ItemTemplate="{StaticResource DiagnosticRow}"
                                      Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Verificação de latência de drivers ===================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding DriverExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_DrvTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Lat_DrvSubtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding DriverExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding DriverExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>
                    <StackPanel Margin="0,12,0,0" anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding DriverExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold"
                                       Content="{Binding [Lat_DrvCheck], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding CheckDriverLatencyCommand}"
                                       IsEnabled="{Binding IsCheckingDriverLatency, Converter={StaticResource InvBool}}" />
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsCheckingDriverLatency, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DriverLatencyHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"
                                   Foreground="{Binding DriverLatencyColor, Converter={StaticResource StrToBrush}}"
                                   Visibility="{Binding HasDriverLatencyResult, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding DriverLatencyLines}" ItemTemplate="{StaticResource DiagnosticRow}"
                                      Visibility="{Binding HasDriverLatencyResult, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Servidores de teste ===================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding TestServersExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_TestServers], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Lat_TestServersSubtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding TestServersExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding TestServersExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>
                    <StackPanel Margin="0,12,0,0" anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding TestServersExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="{Binding [Lat_TestNow], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestServersCommand}"
                                       IsEnabled="{Binding IsTestingServers, Converter={StaticResource InvBool}}" />
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsTestingServers, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TestServers}" ItemTemplate="{StaticResource TestServerRow}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Otimizações e ferramentas ===================== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding ToolsExpanded, Mode=TwoWay}" Style="{StaticResource GhostToggle}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_ToolsTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding [Lat_ToolsSubtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding ToolsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronUp24" Style="{StaticResource Chevron}"
                                           Visibility="{Binding ToolsExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>
                    <StackPanel anim:Anim.AnimateVisibility="True"
                                Visibility="{Binding ToolsExpanded, Converter={StaticResource BoolToVis}}">

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                        <ui:Button Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold"
                                   Content="{Binding [Lat_ApplyAll], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding ApplyAllCommand}" IsEnabled="{Binding IsApplyingAll, Converter={StaticResource InvBool}}" />
                        <!-- Sempre à vista (antes sumia e parecia não haver como voltar atrás);
                             desabilitado só quando não há nada aplicado pelo Pulse1x. -->
                        <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}"
                                   Content="{Binding [Lat_RestoreAll], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding RestoreAllCommand}" Margin="8,0,0,0"
                                   IsEnabled="{Binding CanRestoreAll}"
                                   ToolTip="{Binding [Lat_RestoreAllTip], Source={x:Static loc:Loc.Instance}}"
                                   ToolTipService.ShowOnDisabled="True" />
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsApplyingAll, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <!-- String → Visibility: com o conversor de bool esta mensagem nunca aparecia. -->
                    <TextBlock Text="{Binding ApplyAllStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding ApplyAllStatus, Converter={StaticResource StrToVis}}" />

                    <!-- DNS -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="10" Margin="0,8,0,12"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Lat_ToolDns], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [Lat_ToolDnsDesc], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="190" Margin="10,0,8,0"
                                      ItemsSource="{Binding DnsOptions}" DisplayMemberPath="Label"
                                      SelectedIndex="{Binding SelectedDnsIndex, Mode=TwoWay}" />
                            <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="84">
                                <StackPanel Visibility="{Binding IsApplyingDns, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <ui:Button HorizontalAlignment="Stretch"
                                               Content="{Binding [Lat_Apply], Source={x:Static loc:Loc.Instance}}" Command="{Binding ApplyDnsCommand}" />
                                    <ui:Button HorizontalAlignment="Stretch" Margin="0,6,0,0" Icon="{ui:SymbolIcon ArrowUndo24}"
                                               Content="{Binding [Lat_Revert], Source={x:Static loc:Loc.Instance}}" Command="{Binding RevertDnsCommand}"
                                               ToolTip="{Binding [Lat_RevertDnsTip], Source={x:Static loc:Loc.Instance}}"
                                               Visibility="{Binding DnsCanRevert, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                                 Visibility="{Binding IsApplyingDns, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [Lat_GroupActions], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource GroupLabel}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_GroupTweaks], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource GroupLabel}" />
                    <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_GroupAdapter], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource GroupLabel}" />
                    <ItemsControl ItemsSource="{Binding AdapterTweaks}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_GroupProfiles], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource GroupLabel}" />
                    <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource ToolCard}" />

                    <TextBlock Text="{Binding [Lat_ReversibleNote], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
