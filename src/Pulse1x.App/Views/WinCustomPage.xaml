<Page
    x:Class="Pulse1x.App.Views.WinCustomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    Title="Personalização do Windows">

    <Grid Margin="16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">

            <ui:SymbolIcon Symbol="PaintBrush24" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource BrandAccentBrush}" Opacity="0.85" />

            <TextBlock Text="{Binding [WinCustom_Title], Source={x:Static loc:Loc.Instance}}"
                       FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,14,0,0" />

            <Border Background="{DynamicResource BrandAccentBrush}" CornerRadius="4"
                    Padding="10,3" Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding [WinCustom_ComingSoon], Source={x:Static loc:Loc.Instance}}"
                           FontSize="11.5" FontWeight="Bold" Foreground="White" />
            </Border>

            <TextBlock Text="{Binding [WinCustom_ComingSoonBody], Source={x:Static loc:Loc.Instance}}"
                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,16,0,0" LineHeight="20" />
        </StackPanel>
    </Grid>
</Page>
