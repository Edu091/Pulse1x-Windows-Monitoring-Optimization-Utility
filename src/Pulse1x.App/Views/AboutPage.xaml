<Page
    x:Class="Pulse1x.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    Title="Sobre">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="560">
            <TextBlock Text="Pulse1x" FontSize="24" FontWeight="Bold" />

            <!-- A versão é preenchida no code-behind a partir do assembly. -->
            <TextBlock x:Name="VersionText" Opacity="0.7" Margin="0,4,0,16" />

            <TextBlock Text="{Binding [About_Description], Source={x:Static loc:Loc.Instance}}"
                       TextWrapping="Wrap" Opacity="0.85" />

            <!-- Histórico de versões: recolhido por padrão para não empurrar o restante da página. -->
            <ui:Button x:Name="ChangelogToggle" Click="ToggleChangelog"
                       HorizontalAlignment="Left" Margin="0,18,0,0" />

            <Border x:Name="ChangelogPanel" Visibility="Collapsed" Margin="0,12,0,0"
                    CornerRadius="8" Padding="16,12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel x:Name="ChangelogContent" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
