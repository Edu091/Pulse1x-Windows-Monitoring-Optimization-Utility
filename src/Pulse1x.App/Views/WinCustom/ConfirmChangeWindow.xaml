<ui:FluentWindow
    x:Class="Pulse1x.App.Views.WinCustom.ConfirmChangeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Pulse1x"
    Width="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pulse1x" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" FontSize="13" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- Barra que esvazia junto com a contagem: deixa o prazo evidente sem precisar ler. -->
            <ProgressBar x:Name="CountdownBar" Height="4" Minimum="0" Maximum="5" Value="5" Margin="0,0,0,6" />
            <TextBlock x:Name="CountdownText" FontSize="12" Opacity="0.7" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="RevertButton" Width="150" Margin="0,0,8,0" />
                <ui:Button x:Name="KeepButton" Width="150" Appearance="Primary" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
