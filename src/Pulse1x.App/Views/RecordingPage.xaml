<Page
    x:Class="Pulse1x.App.Views.RecordingPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:controls="clr-namespace:Pulse1x.App.Controls"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:RecordingViewModel}"
    mc:Ignorable="d"
    Title="Gravação">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,20">
            <!-- Cabeçalho -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding [Rec_PageTitle], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [Rec_PageSubtitle], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,320,12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ui:Button Content="{Binding ToolbarButtonText}" Command="{Binding ToggleToolbarCommand}"
                               Icon="{ui:SymbolIcon Apps24}" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding [Rec_OpenFolder], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenFolderCommand}"
                               Icon="{ui:SymbolIcon Folder24}" />
                </StackPanel>
            </Grid>

            <!-- Motor de gravação (ffmpeg) -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,5,12,0"
                             Fill="{Binding EngineStatusColor, Converter={StaticResource StrToBrush}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding [Rec_EngineTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding EngineStatus}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding [Rec_EngineExplain], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <controls:FunctionInfo InfoKey="RecInfo_Engine" />
                        <ProgressBar Value="{Binding InstallProgress}" Maximum="100" Height="6" Margin="0,8,0,0"
                                     Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button Content="{Binding [Rec_EngineInstall], Source={x:Static loc:Loc.Instance}}" Command="{Binding InstallFfmpegCommand}"
                                   Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                   Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Content="{Binding [Rec_Cancel], Source={x:Static loc:Loc.Instance}}" Command="{Binding CancelInstallCommand}"
                                   HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Content="{Binding [Rec_BrowseFfmpeg], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseFfmpegCommand}"
                                   Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Controle da gravação -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{Binding StateColor, Converter={StaticResource StrToBrush}}" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ElapsedText}" FontSize="28" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveInfo}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Visibility="{Binding ActiveInfo, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding StatusText, Converter={StaticResource StrToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#22C55E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#F97316" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ToggleButton IsChecked="{Binding MicMuted}" Padding="10,8" Margin="0,0,8,0"
                                      ToolTip="{Binding [Rec_OverlayMicMute], Source={x:Static loc:Loc.Instance}}"
                                      Visibility="{Binding HasMicrophoneTrack, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="MicOff24" />
                        </ToggleButton>
                        <ui:Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" Icon="{ui:SymbolIcon Pause24}"
                                   Padding="14,8" Margin="0,0,8,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Content="{Binding MainButtonText}" Command="{Binding StartStopCommand}" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Record24}" Padding="18,8" MinWidth="150" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- O que gravar + Vídeo -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Rec_WhatTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding [Rec_Monitor], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Name" />
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshMonitorsNowCommand}" Margin="6,0,0,0" Padding="10,7"
                                       ToolTip="{Binding [Rec_RefreshMonitors], Source={x:Static loc:Loc.Instance}}" />
                        </Grid>

                        <TextBlock Text="{Binding [Rec_Area], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                        <RadioButton GroupName="RecArea" Content="{Binding [Rec_AreaFull], Source={x:Static loc:Loc.Instance}}"
                                     IsChecked="{Binding IsRegion, Converter={StaticResource InverseBool}}" Margin="0,0,0,4" />
                        <RadioButton GroupName="RecArea" Content="{Binding [Rec_AreaRegion], Source={x:Static loc:Loc.Instance}}"
                                     IsChecked="{Binding IsRegion}" />
                        <Grid Margin="28,6,0,0" Visibility="{Binding IsRegion, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RegionText}" VerticalAlignment="Center" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                            <ui:Button Grid.Column="1" Content="{Binding [Rec_SelectArea], Source={x:Static loc:Loc.Instance}}" Command="{Binding SelectRegionCommand}"
                                       Icon="{ui:SymbolIcon SelectObject24}" Margin="8,0,0,0" />
                        </Grid>

                        <ui:ToggleSwitch Content="{Binding [Rec_DrawMouse], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding DrawMouse}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Video24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Rec_VideoTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [Rec_Fps], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [Rec_Resolution], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [Rec_Codec], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding SelectedCodec}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [Rec_Encoder], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder}" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding EncoderHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Visibility="{Binding EncoderHint, Converter={StaticResource StrToVis}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [Rec_Quality], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [Rec_Container], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" DisplayMemberPath="Name" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0" Visibility="{Binding IsCustomQuality, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Rec_Bitrate], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
                            <Slider Grid.Column="1" Minimum="2" Maximum="150" Value="{Binding CustomBitrate}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                            <TextBlock Grid.Column="2" Text="{Binding CustomBitrate, StringFormat={}{0} Mbps}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding [Rec_VideoHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Áudio + Atalhos -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Speaker224" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Rec_AudioTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>

                        <ui:ToggleSwitch Content="{Binding [Rec_SystemAudio], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RecordSystemAudio}" Margin="0,12,0,0" />
                        <Grid Margin="0,8,0,0" Visibility="{Binding RecordSystemAudio, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="200" Value="{Binding SystemVolume}" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                            <TextBlock Grid.Column="1" Text="{Binding SystemVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <ui:ToggleSwitch Content="{Binding [Rec_Microphone], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RecordMicrophone}" Margin="0,14,0,0" />
                        <StackPanel Visibility="{Binding RecordMicrophone, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" Margin="0,8,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="200" Value="{Binding MicrophoneVolume}" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                                <TextBlock Grid.Column="1" Text="{Binding MicrophoneVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding [Rec_AudioSync], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="-500" Maximum="500" Value="{Binding AudioOffsetMs}" TickFrequency="10" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                            <TextBlock Grid.Column="1" Text="{Binding AudioOffsetMs, StringFormat={}{0:+0;-0;0} ms}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding [Rec_AudioHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Keyboard24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding [Rec_HotkeysTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding HotkeysEnabled}" />
                        </Grid>
                        <Grid Margin="0,10,0,0" IsEnabled="{Binding HotkeysEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding [Rec_HkStart], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Row="0" Grid.Column="1" Binding="{Binding StartHotkey}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Text="{Binding [Rec_HkStop], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Row="1" Grid.Column="1" Binding="{Binding StopHotkey}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="{Binding [Rec_HkPause], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Row="2" Grid.Column="1" Binding="{Binding PauseHotkey}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Text="{Binding [Rec_HkOverlay], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Row="3" Grid.Column="1" Binding="{Binding OverlayHotkey}" />
                        </Grid>
                        <TextBlock Text="{Binding HotkeyWarning}" FontSize="12" Foreground="#F97316" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HotkeyWarning, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding [Rec_HotkeysHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        <controls:FunctionInfo InfoKey="RecInfo_Hotkeys" />
                        <ui:Button Content="{Binding [Rec_RestoreHotkeys], Source={x:Static loc:Loc.Instance}}" Command="{Binding RestoreHotkeysCommand}"
                                   Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Arquivos e comportamento -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [Rec_BehaviorTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [Rec_Folder], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <TextBlock Text="{Binding OutputFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}" />
                        </Border>
                        <ui:Button Grid.Column="1" Content="{Binding [Rec_ChangeFolder], Source={x:Static loc:Loc.Instance}}" Command="{Binding ChangeFolderCommand}"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}" />
                        <ui:Button Grid.Column="2" Content="{Binding [Rec_DefaultFolder], Source={x:Static loc:Loc.Instance}}" Command="{Binding ResetFolderCommand}"
                                   Margin="8,0,0,0" IsEnabled="{Binding IsIdle}"
                                   ToolTip="{Binding [Rec_DefaultFolderTip], Source={x:Static loc:Loc.Instance}}" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Rec_Countdown], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Countdowns}" SelectedItem="{Binding SelectedCountdown}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,8,0,0">
                            <ui:ToggleSwitch Content="{Binding [Rec_ShowIndicator], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding ShowIndicator}" Margin="0,4,0,0" />
                            <ui:ToggleSwitch Content="{Binding [Rec_SoundCues], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SoundCues}" Margin="0,8,0,0" />
                            <ui:ToggleSwitch Content="{Binding [Rec_OpenWhenDone], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding OpenFolderWhenDone}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Xbox Game Bar -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="XboxController24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Rec_GameBarTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="{Binding [Rec_OpenGameBarSettings], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenGameBarSettingsCommand}"
                                       Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,0" />
                            <ui:Button Content="{Binding [Rec_OpenCaptureSettings], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenCaptureSettingsCommand}"
                                       Icon="{ui:SymbolIcon Open24}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding [Rec_GameBarExplain], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Rec_GameDvrName], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GameDvrStateText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            <controls:FunctionInfo InfoKey="AdvInfo_game-dvr" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{Binding GameDvrButtonText}" Command="{Binding ToggleGameDvrCommand}" VerticalAlignment="Top"
                                   Margin="12,0,0,0" MinWidth="130" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Rec_GameBarName], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GameBarStateText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            <controls:FunctionInfo InfoKey="AdvInfo_xbox-gamebar" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{Binding GameBarButtonText}" Command="{Binding ToggleGameBarCommand}" VerticalAlignment="Top"
                                   Margin="12,0,0,0" MinWidth="130" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Gravações recentes -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="VideoClipMultiple24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Rec_RecentTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding LibraryInfo}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshLibraryCommand}" Margin="0,0,8,0"
                                       ToolTip="{Binding [Rec_RefreshLibrary], Source={x:Static loc:Loc.Instance}}" />
                            <ui:Button Content="{Binding [Rec_DeleteAll], Source={x:Static loc:Loc.Instance}}" Command="{Binding DeleteAllCommand}"
                                       Icon="{ui:SymbolIcon Delete24}" IsEnabled="{Binding HasRecordings}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding [Rec_RecentEmpty], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                               Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Recordings}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="0,0,12,12" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="8,8,0,0" Background="#40000000" ClipToBounds="True" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Video24" FontSize="32" Opacity="0.4" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border Background="#B0000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                        Visibility="{Binding DurationText, Converter={StaticResource StrToVis}}">
                                                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,8,10,10">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,8">
                                                <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Icon="{ui:SymbolIcon Play24}" Padding="8,5" Margin="0,0,6,0"
                                                           Content="{Binding [Rec_Play], Source={x:Static loc:Loc.Instance}}"
                                                           Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Padding="8,5" Margin="0,0,6,0"
                                                           ToolTip="{Binding [Rec_ShowInFolder], Source={x:Static loc:Loc.Instance}}"
                                                           Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Padding="8,5"
                                                           ToolTip="{Binding [Rec_Delete], Source={x:Static loc:Loc.Instance}}"
                                                           Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
