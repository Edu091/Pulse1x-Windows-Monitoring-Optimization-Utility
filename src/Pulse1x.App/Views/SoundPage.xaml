<Page
    x:Class="Pulse1x.App.Views.SoundPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:SoundViewModel}"
    mc:Ignorable="d"
    Title="Som">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="6" />
        </Style>

        <!-- Cartões selecionáveis (perfis e efeitos de voz) -->
        <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding [Snd_PageTitle], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [Snd_PageSubtitle], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,140,12" />
                </StackPanel>
                <ui:Button Content="{Binding [Snd_Refresh], Source={x:Static loc:Loc.Instance}}" Command="{Binding RefreshCommand}"
                           Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Motor de áudio -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,5,12,0"
                             Fill="{Binding ApoStatusColor, Converter={StaticResource StrToBrush}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding [Snd_EngineTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ApoStatus}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding [Snd_EngineExplain], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button Content="{Binding [Snd_ApoDownload], Source={x:Static loc:Loc.Instance}}" Command="{Binding DownloadApoCommand}"
                                   Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" HorizontalAlignment="Stretch"
                                   Visibility="{Binding ApoInstalled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ui:Button Content="{Binding [Snd_ApoDevices], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenDeviceSelectorCommand}"
                                   Icon="{ui:SymbolIcon Settings24}" HorizontalAlignment="Stretch"
                                   Visibility="{Binding ApoInstalled, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#F97316" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding StatusText, Converter={StaticResource StrToVis}}" />

            <!-- Saída e microfone lado a lado -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Saída -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Speaker224" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Snd_Output], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Display" />
                            <ui:Button Grid.Column="1" Content="{Binding [Snd_MakeDefault], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding MakeOutputDefaultCommand}" Margin="6,0,0,0" Padding="10,6"
                                       ToolTip="{Binding [Snd_MakeDefaultTip], Source={x:Static loc:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton IsChecked="{Binding OutputMuted}" Padding="6" Margin="0,0,8,0"
                                          ToolTip="{Binding [Snd_Mute], Source={x:Static loc:Loc.Instance}}">
                                <ui:SymbolIcon Symbol="SpeakerMute24" />
                            </ToggleButton>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding OutputVolume}" VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True" />
                            <TextBlock Grid.Column="2" Text="{Binding OutputVolume, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding OutputPeak, Mode=OneWay}" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding [Snd_TestOutput], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" Margin="0,12,0,4" />
                        <WrapPanel>
                            <ui:Button Content="{Binding [Snd_ToneLeftBtn], Source={x:Static loc:Loc.Instance}}" Command="{Binding PlayToneCommand}" CommandParameter="Left" Margin="0,0,6,6" Padding="10,4" />
                            <ui:Button Content="{Binding [Snd_ToneRightBtn], Source={x:Static loc:Loc.Instance}}" Command="{Binding PlayToneCommand}" CommandParameter="Right" Margin="0,0,6,6" Padding="10,4" />
                            <ui:Button Content="{Binding [Snd_ToneBothBtn], Source={x:Static loc:Loc.Instance}}" Command="{Binding PlayToneCommand}" CommandParameter="Both" Margin="0,0,6,6" Padding="10,4" />
                            <ui:Button Content="{Binding [Snd_ToneBassBtn], Source={x:Static loc:Loc.Instance}}" Command="{Binding PlayToneCommand}" CommandParameter="Bass" Margin="0,0,6,6" Padding="10,4" />
                            <ui:Button Content="{Binding [Snd_ToneSweepBtn], Source={x:Static loc:Loc.Instance}}" Command="{Binding PlayToneCommand}" CommandParameter="Sweep" Margin="0,0,6,6" Padding="10,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Microfone -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Mic24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Snd_Input], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="Display" />
                            <ui:Button Grid.Column="1" Content="{Binding [Snd_MakeDefault], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding MakeInputDefaultCommand}" Margin="6,0,0,0" Padding="10,6"
                                       ToolTip="{Binding [Snd_MakeDefaultTip], Source={x:Static loc:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton IsChecked="{Binding InputMuted}" Padding="6" Margin="0,0,8,0"
                                          ToolTip="{Binding [Snd_Mute], Source={x:Static loc:Loc.Instance}}">
                                <ui:SymbolIcon Symbol="MicOff24" />
                            </ToggleButton>
                            <Slider Grid.Column="1" Minimum="0" Maximum="400" Value="{Binding MicLevel}" VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True" TickFrequency="100" TickPlacement="BottomRight" />
                            <TextBlock Grid.Column="2" Text="{Binding MicLevelText}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding MicLevelDetail}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding [Snd_MicNeedsEngine], Source={x:Static loc:Loc.Instance}}" FontSize="11" Foreground="#F97316" TextWrapping="Wrap"
                                   Visibility="{Binding MicNeedsEngine, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding InputPeak, Mode=OneWay}" Margin="0,8,0,0" />

                        <!-- Amplificação de hardware -->
                        <Grid Margin="0,10,0,0" Visibility="{Binding HasHardwareBoost, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [Snd_HwBoost], Source={x:Static loc:Loc.Instance}}" FontSize="13" />
                                <TextBlock Text="{Binding [Snd_HwBoostHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding HardwareBoostSteps}" SelectedItem="{Binding SelectedBoost}"
                                      DisplayMemberPath="Display" VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="{Binding [Snd_LowCut], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding MicLowCut}" Margin="0,10,0,0" />
                        <CheckBox Content="{Binding [Snd_Clarity], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding MicClarity}" Margin="0,2,0,0" />

                        <TextBlock Text="{Binding [Snd_TestInput], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" Margin="0,12,0,4" />
                        <WrapPanel>
                            <ui:Button Command="{Binding ToggleMicTestCommand}" Margin="0,0,6,6" Padding="10,4" Icon="{ui:SymbolIcon Pulse24}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Content" Value="{Binding [Snd_MicTest], Source={x:Static loc:Loc.Instance}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMicTesting}" Value="True">
                                                <Setter Property="Content" Value="{Binding [Snd_StopTest], Source={x:Static loc:Loc.Instance}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="{Binding [Snd_RecordPlay], Source={x:Static loc:Loc.Instance}}" Command="{Binding RecordAndPlayCommand}"
                                       Margin="0,0,6,6" Padding="10,4" Icon="{ui:SymbolIcon Record24}" />
                            <ui:Button Command="{Binding ToggleMonitorCommand}" Margin="0,0,6,6" Padding="10,4" Icon="{ui:SymbolIcon HeadphonesSoundWave24}"
                                       ToolTip="{Binding [Snd_MonitorTip], Source={x:Static loc:Loc.Instance}}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Content" Value="{Binding [Snd_Monitor], Source={x:Static loc:Loc.Instance}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Content" Value="{Binding [Snd_MonitorStop], Source={x:Static loc:Loc.Instance}}" />
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding TestStatus}" FontSize="12" Foreground="{DynamicResource BrandAccentBrush}" TextWrapping="Wrap" Margin="0,-4,0,10"
                       Visibility="{Binding TestStatus, Converter={StaticResource StrToVis}}" />

            <!-- Perfis e equalizador -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataBarVertical24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [Snd_EqTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="{Binding [Snd_EqReset], Source={x:Static loc:Loc.Instance}}" Command="{Binding ResetEqualizerCommand}" Padding="10,3" Margin="0,0,10,0" />
                            <ui:ToggleSwitch Content="{Binding [Snd_EffectsOn], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding OutputEffectsEnabled}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding [Snd_EqHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,4,0,8" />

                    <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundOption}">
                                <StackPanel Width="120" ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 10 bandas -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="8,10" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ValueText}" FontSize="11" HorizontalAlignment="Center" Opacity="0.8" />
                                        <Slider Orientation="Vertical" Minimum="-12" Maximum="12" Height="150" Value="{Binding Value}"
                                                HorizontalAlignment="Center" Margin="0,4" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                IsMoveToPointEnabled="True" />
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Graves, 3D e ganho -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding [Snd_Bass], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BassBoostText}" HorizontalAlignment="Right" Opacity="0.8" />
                            </Grid>
                            <Slider Minimum="0" Maximum="12" Value="{Binding BassBoost}" TickFrequency="0.5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" />
                            <TextBlock Text="{Binding [Snd_BassHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Text="{Binding [Snd_Surround], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SurroundText}" HorizontalAlignment="Right" Opacity="0.8" />
                            </Grid>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Surround}" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" />
                            <TextBlock Text="{Binding [Snd_SurroundHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Grid>
                                <TextBlock Text="{Binding [Snd_Gain], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OutputGainText}" HorizontalAlignment="Right" Opacity="0.8" />
                            </Grid>
                            <Slider Minimum="-12" Maximum="6" Value="{Binding OutputGain}" TickFrequency="0.5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" />
                            <TextBlock Text="{Binding [Snd_GainHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Modificador de voz -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PersonVoice24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [Snd_VoiceTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [Snd_VoiceHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,4,0,8" />

                    <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundOption}">
                                <StackPanel Width="84" ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding SelectedVoice.Description}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding [Snd_VoiceApps], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Inicialização -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Power24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [Snd_StartupTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <ui:ToggleSwitch Content="{Binding [Snd_ApplyOnStartup], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding ApplyOnStartup}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding [Snd_ApplyOnStartupHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,2,0,8" />
                    <ui:ToggleSwitch Content="{Binding [Snd_LockMic], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding LockMicLevel}" />
                    <TextBlock Text="{Binding [Snd_LockMicHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
