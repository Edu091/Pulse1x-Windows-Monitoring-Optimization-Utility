<Page
    x:Class="Pulse1x.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pulse1x.App.Controls"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:anim="clr-namespace:Pulse1x.App.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    Title="Dashboard"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolOrVisibilityConverter x:Key="BoolOrVis" />
        <converters:HiddenSectionPlaceholderVisibilityConverter x:Key="HiddenPlaceholderVis" />

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- TargetType="Control" porque este estilo é aplicado tanto a ui:Button quanto a
             ToggleButton; ambos derivam de Control, que tem Padding/Margin/FontSize. -->
        <Style x:Key="SectionToolButton" TargetType="Control">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <ui:InfoBar
                Title="{Binding [Dashboard_SensorWarningTitle], Source={x:Static loc:Loc.Instance}}"
                Message="{Binding SensorWarningMessage}"
                Severity="Error"
                IsOpen="{Binding SensorWarningVisible}"
                Margin="0,0,0,12" />

            <!-- Barra de personalização do layout -->
            <Grid Margin="6,0,6,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pulse1x" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <ToggleButton
                    Grid.Column="1"
                    Style="{StaticResource BrandToggle}"
                    Content="{Binding [Dashboard_Customize], Source={x:Static loc:Loc.Instance}}"
                    IsChecked="{Binding IsCustomizing, Mode=TwoWay}" />
            </Grid>

            <Grid x:Name="SectionsHost">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===================== Informações do sistema ===================== -->
                <StackPanel x:Name="SystemInfoSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="SystemInfoSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SystemInfoSection.Title}" Style="{StaticResource SectionHeaderText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding SystemInfoSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding SystemInfoSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding SystemInfoSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="SystemInfoSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <Border
                        Visibility="{Binding SystemInfoSection.IsVisible, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="8"
                        Margin="6,0,6,0">
                        <ItemsControl ItemsSource="{Binding SystemInfo}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="330" Margin="8,6">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ===================== Monitoramento em tempo real ===================== -->
                <StackPanel x:Name="MetricsSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="MetricsSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding MetricsSection.Title}" Style="{StaticResource SectionHeaderText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding MetricsSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding MetricsSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding MetricsSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="MetricsSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <WrapPanel Orientation="Horizontal" Visibility="{Binding MetricsSection.IsVisible, Converter={StaticResource BoolToVis}}">
                        <controls:MetricCard
                            Width="220"
                            Title="{Binding CpuName}"
                            Badge="CPU"
                            AccentColor="#DC2626"
                            PrimaryValue="{Binding CpuUsagePercent, StringFormat='{}{0:0.#}%'}"
                            SecondaryValue="{Binding CpuDetailsText}"
                            Percent="{Binding CpuUsagePercent}"
                            Level="{Binding CpuUsageLevel}"
                            DetailKind="cpu"
                            Clicked="MetricCard_Clicked" />

                        <ItemsControl ItemsSource="{Binding GpuMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MetricCard
                                        Width="220"
                                        Title="{Binding Name}"
                                        Badge="GPU"
                                        AccentColor="{Binding AccentColor}"
                                        PrimaryValue="{Binding UsagePercent, StringFormat='{}{0:0.#}%'}"
                                        SecondaryValue="{Binding TemperatureText}"
                                        Percent="{Binding UsagePercent}"
                                        Level="{Binding UsageLevel}"
                                        DetailKind="gpu"
                                        DetailId="{Binding Name}"
                                        Clicked="MetricCard_Clicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MetricCard
                            Width="220"
                            Title="{Binding [Dashboard_Ram], Source={x:Static loc:Loc.Instance}}"
                            Badge="RAM"
                            AccentColor="#10B981"
                            PrimaryValue="{Binding RamUsagePercent, StringFormat='{}{0:0.#}%'}"
                            SecondaryValue="{Binding RamUsedText}"
                            Percent="{Binding RamUsagePercent}"
                            Level="{Binding RamUsageLevel}"
                            DetailKind="ram"
                            Clicked="MetricCard_Clicked" />

                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MetricCard
                                        Width="220"
                                        Title="{Binding Title}"
                                        Badge="{Binding Name}"
                                        AccentColor="#E11D48"
                                        PrimaryValue="{Binding PrimaryValue}"
                                        SecondaryValue="{Binding SecondaryValue}"
                                        Percent="{Binding UsagePercent}"
                                        Level="{Binding UsageLevel}"
                                        DetailKind="disk"
                                        DetailId="{Binding Name}"
                                        Clicked="MetricCard_Clicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MetricCard
                            Width="220"
                            Title="{Binding [Dashboard_Network], Source={x:Static loc:Loc.Instance}}"
                            Badge="NET"
                            AccentColor="#F59E0B"
                            PrimaryValue="{Binding DownloadSpeedText}"
                            SecondaryValue="{Binding UploadSpeedText}"
                            ShowProgress="False"
                            Level="Normal"
                            DetailKind="net"
                            Clicked="MetricCard_Clicked" />
                    </WrapPanel>
                </StackPanel>

                <!-- ===================== Gráficos ===================== -->
                <StackPanel x:Name="ChartsSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="ChartsSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ChartsSection.Title}" Style="{StaticResource SectionHeaderText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding ChartsSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding ChartsSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding ChartsSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="ChartsSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <WrapPanel Orientation="Horizontal" Visibility="{Binding ChartsSection.IsVisible, Converter={StaticResource BoolToVis}}">
                        <controls:LiveChart Width="560" Title="{Binding [Dashboard_ChartCpu], Source={x:Static loc:Loc.Instance}}" Values="{Binding CpuChartValues}" AccentColor="#DC2626" />

                        <ItemsControl ItemsSource="{Binding GpuMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:LiveChart
                                        Width="560"
                                        Title="{Binding ChartTitle}"
                                        Values="{Binding ChartValues}"
                                        AccentColor="{Binding AccentColor}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:LiveChart Width="560" Title="{Binding [Dashboard_ChartRam], Source={x:Static loc:Loc.Instance}}" Values="{Binding RamChartValues}" AccentColor="#10B981" />
                        <controls:LiveChart Width="560" Title="{Binding [Dashboard_ChartNet], Source={x:Static loc:Loc.Instance}}" Values="{Binding NetworkChartValues}" AccentColor="#F59E0B" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
