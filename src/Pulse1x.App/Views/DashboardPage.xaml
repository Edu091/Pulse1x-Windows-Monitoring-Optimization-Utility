<Page
    x:Class="Pulse1x.App.Views.DashboardPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Pulse1x.App.Controls"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:anim="clr-namespace:Pulse1x.App.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    Title="Dashboard"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolOrVisibilityConverter x:Key="BoolOrVis" />
        <converters:HiddenSectionPlaceholderVisibilityConverter x:Key="HiddenPlaceholderVis" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />

        <!-- Cartão de um item de BIOS/Windows: faixa colorida pelo estado, valor, compatibilidade e dica. -->
        <DataTemplate x:Key="FirmwareTile" DataType="{x:Type vm:FirmwareItemViewModel}">
            <Border Width="330" Margin="6" CornerRadius="8" Padding="12,9" BorderThickness="3,0,0,0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{Binding Color, Converter={StaticResource StrToBrush}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Title}" FontSize="12" Opacity="0.65" />
                        <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Foreground="{Binding Color, Converter={StaticResource StrToBrush}}" />
                    </Grid>
                    <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Compatibility}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Compatibility, Converter={StaticResource StrToVis}}" />
                    <TextBlock Text="{Binding Tip}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding Tip, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- TargetType="Control" porque este estilo é aplicado tanto a ui:Button quanto a
             ToggleButton; ambos derivam de Control, que tem Padding/Margin/FontSize. -->
        <Style x:Key="SectionToolButton" TargetType="Control">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <ui:InfoBar
                Title="{Binding [Dashboard_SensorWarningTitle], Source={x:Static loc:Loc.Instance}}"
                Message="{Binding SensorWarningMessage}"
                Severity="Error"
                IsOpen="{Binding SensorWarningVisible}"
                Margin="0,0,0,12" />

            <!-- Barra de personalização do layout -->
            <Grid Margin="6,0,6,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pulse1x" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <ToggleButton
                    Grid.Column="1"
                    Style="{StaticResource BrandToggle}"
                    Content="{Binding [Dashboard_Customize], Source={x:Static loc:Loc.Instance}}"
                    IsChecked="{Binding IsCustomizing, Mode=TwoWay}" />
            </Grid>

            <Grid x:Name="SectionsHost">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===================== Informações do sistema ===================== -->
                <StackPanel x:Name="SystemInfoSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="SystemInfoSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SystemInfoSection.Title}" Style="{StaticResource SectionHeaderText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding SystemInfoSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding SystemInfoSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding SystemInfoSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="SystemInfoSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <Border
                        Visibility="{Binding SystemInfoSection.IsVisible, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="8"
                        Margin="6,0,6,0">
                        <ItemsControl ItemsSource="{Binding SystemInfo}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="330" Margin="8,6">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ===================== BIOS e desempenho ===================== -->
                <StackPanel x:Name="FirmwareSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="FirmwareSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding FirmwareSection.Title}" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock Text="{Binding FirmwareSummary}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="10,2,0,0" />
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0"
                                             Visibility="{Binding IsFirmwareLoading, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding FirmwareSection.IsVisible, Converter={StaticResource BoolToVis}}">
                            <!-- A seção começa recolhida: é detalhe de configuração, não monitoramento. -->
                            <ui:Button Padding="10,4" Margin="2,0" FontSize="12" Content="{Binding FirmwareToggleText}"
                                       Command="{Binding ToggleFirmwareCommand}" Appearance="Secondary" />
                            <ui:Button Padding="10,4" Margin="2,0" FontSize="12" Content="{Binding [Fw_Refresh], Source={x:Static loc:Loc.Instance}}"
                                       Visibility="{Binding IsFirmwareExpanded, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding RefreshFirmwareCommand}" Icon="{ui:SymbolIcon ArrowSync20}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding FirmwareSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding FirmwareSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding FirmwareSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="FirmwareSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <Border Visibility="{Binding FirmwareSection.IsVisible, Converter={StaticResource BoolToVis}}">
                    <Border Visibility="{Binding IsFirmwareExpanded, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="8" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Fw_GroupBios], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Margin="8,4,0,0" />
                            <ItemsControl ItemsSource="{Binding FirmwareBiosItems}" ItemTemplate="{StaticResource FirmwareTile}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding [Fw_GroupWindows], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Margin="8,8,0,0" />
                            <ItemsControl ItemsSource="{Binding FirmwareWindowsItems}" ItemTemplate="{StaticResource FirmwareTile}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Grid Margin="8,6,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Fw_Footer], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Padding="10,4" Margin="8,0,0,0" FontSize="12" Content="{Binding [Fw_RestartToBios], Source={x:Static loc:Loc.Instance}}"
                                           Command="{Binding RestartToFirmwareCommand}" Icon="{ui:SymbolIcon ArrowReset20}"
                                           Visibility="{Binding CanRestartToFirmware, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Border>
                </StackPanel>

                <!-- ===================== Monitoramento em tempo real ===================== -->
                <StackPanel x:Name="MetricsSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="MetricsSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding MetricsSection.Title}" Style="{StaticResource SectionHeaderText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding MetricsSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding MetricsSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding MetricsSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="MetricsSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <WrapPanel Orientation="Horizontal" Visibility="{Binding MetricsSection.IsVisible, Converter={StaticResource BoolToVis}}">
                        <controls:MetricCard
                            Width="220"
                            Title="{Binding CpuName}"
                            Badge="CPU"
                            AccentColor="{DynamicResource BrandAccentColor}"
                            PrimaryValue="{Binding CpuUsagePercent, StringFormat='{}{0:0.#}%'}"
                            SecondaryValue="{Binding CpuDetailsText}"
                            Percent="{Binding CpuUsagePercent}"
                            Level="{Binding CpuUsageLevel}"
                            DetailKind="cpu"
                            Clicked="MetricCard_Clicked" />

                        <ItemsControl ItemsSource="{Binding GpuMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MetricCard
                                        Width="220"
                                        Title="{Binding Name}"
                                        Badge="GPU"
                                        AccentColor="{Binding AccentColor}"
                                        PrimaryValue="{Binding UsagePercent, StringFormat='{}{0:0.#}%'}"
                                        SecondaryValue="{Binding TemperatureText}"
                                        Percent="{Binding UsagePercent}"
                                        Level="{Binding UsageLevel}"
                                        DetailKind="gpu"
                                        DetailId="{Binding Name}"
                                        Clicked="MetricCard_Clicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MetricCard
                            Width="220"
                            Title="{Binding [Dashboard_Ram], Source={x:Static loc:Loc.Instance}}"
                            Badge="RAM"
                            AccentColor="#10B981"
                            PrimaryValue="{Binding RamUsagePercent, StringFormat='{}{0:0.#}%'}"
                            SecondaryValue="{Binding RamUsedText}"
                            Percent="{Binding RamUsagePercent}"
                            Level="{Binding RamUsageLevel}"
                            DetailKind="ram"
                            Clicked="MetricCard_Clicked" />

                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MetricCard
                                        Width="220"
                                        Title="{Binding Title}"
                                        Badge="{Binding Name}"
                                        AccentColor="#E11D48"
                                        PrimaryValue="{Binding PrimaryValue}"
                                        SecondaryValue="{Binding SecondaryValue}"
                                        Percent="{Binding UsagePercent}"
                                        Level="{Binding UsageLevel}"
                                        DetailKind="disk"
                                        DetailId="{Binding Name}"
                                        Clicked="MetricCard_Clicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:MetricCard
                            Width="220"
                            Title="{Binding [Dashboard_Network], Source={x:Static loc:Loc.Instance}}"
                            Badge="NET"
                            AccentColor="#F59E0B"
                            PrimaryValue="{Binding DownloadSpeedText}"
                            SecondaryValue="{Binding UploadSpeedText}"
                            ShowProgress="False"
                            Level="Normal"
                            DetailKind="net"
                            Clicked="MetricCard_Clicked" />
                    </WrapPanel>
                </StackPanel>

                <!-- ===================== Gráficos ===================== -->
                <StackPanel x:Name="ChartsSectionRoot" Margin="0,0,0,16">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolOrVis}">
                            <Binding Path="IsCustomizing" />
                            <Binding Path="ChartsSection.IsVisible" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Grid Margin="6,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ChartsSection.Title}" Style="{StaticResource SectionHeaderText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" anim:Anim.AnimateVisibility="True" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}">
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↑" Command="{Binding MoveSectionUpCommand}" CommandParameter="{Binding ChartsSection}" />
                            <ui:Button Style="{StaticResource SectionToolButton}" Content="↓" Command="{Binding MoveSectionDownCommand}" CommandParameter="{Binding ChartsSection}" />
                            <ToggleButton Style="{StaticResource BrandToggle}" Padding="7,4" Margin="2,0" FontSize="13" Content="👁" IsChecked="{Binding ChartsSection.IsVisible, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{Binding [Dashboard_HiddenSection], Source={x:Static loc:Loc.Instance}}"
                        FontStyle="Italic" Opacity="0.5" Margin="6,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource HiddenPlaceholderVis}">
                                <Binding Path="IsCustomizing" />
                                <Binding Path="ChartsSection.IsVisible" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <WrapPanel Orientation="Horizontal" Visibility="{Binding ChartsSection.IsVisible, Converter={StaticResource BoolToVis}}">
                        <controls:LiveChart Width="560" Title="{Binding [Dashboard_ChartCpu], Source={x:Static loc:Loc.Instance}}" Values="{Binding CpuChartValues}" AccentColor="{DynamicResource BrandAccentColor}" />

                        <ItemsControl ItemsSource="{Binding GpuMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:LiveChart
                                        Width="560"
                                        Title="{Binding ChartTitle}"
                                        Values="{Binding ChartValues}"
                                        AccentColor="{Binding AccentColor}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:LiveChart Width="560" Title="{Binding [Dashboard_ChartRam], Source={x:Static loc:Loc.Instance}}" Values="{Binding RamChartValues}" AccentColor="#10B981" />
                        <controls:LiveChart Width="560" Title="{Binding [Dashboard_ChartNet], Source={x:Static loc:Loc.Instance}}" Values="{Binding NetworkChartValues}" AccentColor="#F59E0B" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
