<ui:FluentWindow
    x:Class="Pulse1x.App.Views.GameHub.GameEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels.GameHub"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:GameEditorViewModel}"
    mc:Ignorable="d"
    Title="Pulse1x"
    Height="560"
    Width="580"
    MinHeight="480"
    MinWidth="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Pulse1x" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,6,22,8">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Text="{Binding [GH_Name], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12" />

                <TextBlock Text="{Binding [GH_Executable], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" />
                <Grid Margin="0,3,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0"
                               Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                               Command="{Binding BrowseExecutableCommand}" />
                </Grid>

                <TextBlock Text="{Binding [GH_Arguments], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" />
                <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12" />

                <TextBlock Text="{Binding [GH_WorkingDirectory], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" />
                <Grid Margin="0,3,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0"
                               Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                               Command="{Binding BrowseWorkingDirectoryCommand}" />
                </Grid>

                <TextBlock Text="{Binding [GH_Category], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" />
                <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Margin="0,3,0,12"
                          Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding [GH_Profile], Source={x:Static loc:Loc.Instance}}" FontSize="12" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProfile}" Margin="0,3,0,14" />

                <ui:ToggleSwitch Content="{Binding [GH_MarkFavorite], Source={x:Static loc:Loc.Instance}}"
                                 IsChecked="{Binding IsFavorite}" Margin="0,0,0,8" />
                <ui:ToggleSwitch Content="{Binding [GH_IsApplication], Source={x:Static loc:Loc.Instance}}"
                                 IsChecked="{Binding IsApplication}" Margin="0,0,0,14" />

                <ui:Button Content="{Binding [GH_ResetArt], Source={x:Static loc:Loc.Instance}}"
                           Command="{Binding ResetArtCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandAccentBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="22,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{Binding [GH_Cancel], Source={x:Static loc:Loc.Instance}}"
                           Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="20,7" />
                <ui:Button Content="{Binding [GH_Save], Source={x:Static loc:Loc.Instance}}"
                           Command="{Binding SaveCommand}" Padding="20,7"
                           Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
