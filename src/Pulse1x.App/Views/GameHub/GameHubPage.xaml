<Page
    x:Class="Pulse1x.App.Views.GameHub.GameHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels.GameHub"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:controls="clr-namespace:Pulse1x.App.Controls"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:GameHubViewModel}"
    mc:Ignorable="d"
    Title="GameHub">

    <!--
        O GameHub tem identidade própria, de propósito: enquanto o resto do Pulse1x segue o Fluent
        do Windows, aqui a linguagem é a de um console — fundo escuro contínuo, tipografia grande,
        cromo mínimo e o conteúdo (as capas) como único protagonista. Por isso esta página define
        suas próprias cores em vez de usar as do tema do app.
    -->
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Paleta própria do hub -->
        <SolidColorBrush x:Key="HubBg" Color="#0A0A0C" />
        <SolidColorBrush x:Key="HubText" Color="#F2F3F5" />
        <SolidColorBrush x:Key="HubTextDim" Color="#8B8F98" />
        <SolidColorBrush x:Key="HubSurface" Color="#16171A" />

        <!-- Botão de cromo: discreto, some no fundo até receber atenção. -->
        <Style x:Key="HubChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HubTextDim}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderThickness="0" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource HubText}" />
                            </Trigger>
                            <!-- Foco do controle: precisa ser visível, senão o usuário navega às cegas. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource HubText}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Botão segmentado: três opções lado a lado dentro de uma mesma caixa, onde só a ativa
            recebe preenchimento. Usado para escolher o que a faixa do topo mostra.
        -->
        <Style x:Key="HubSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegBd" CornerRadius="6" Padding="14,7" Background="Transparent">
                            <TextBlock x:Name="SegLabel" Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource HubTextDim}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegLabel" Property="Foreground" Value="{StaticResource HubText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- O segmento ativo ganha volume, para a escolha se ler de longe. -->
                                <Setter TargetName="SegBd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3DFFFFFF" Offset="0" />
                                            <GradientStop Color="#1FFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="SegLabel" Property="Foreground" Value="{StaticResource HubText}" />
                                <Setter TargetName="SegLabel" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="SegLabel" Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Cartão largo de "Continuar jogando". Formato de banner, maior que as capas da grade, com
            o nome e as horas sobre a arte — o suficiente para reconhecer o jogo de longe e saber
            onde parou, sem precisar da capa vertical.
        -->
        <DataTemplate x:Key="HubWideCardTemplate">
            <!--
                FocusVisualStyle desligado: o anel global do app desenharia um segundo contorno por
                fora do cartão, ao lado do que o próprio template já acende na borda — dois anéis
                em volta do mesmo item pareciam duas seleções.
            -->
            <Button Command="{Binding DataContext.SelectFromContinueCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,16,0"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WideBd" Width="360" Height="202" CornerRadius="18"
                                Background="{StaticResource HubSurface}" BorderThickness="2"
                                BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="WideScale" />
                            </Border.RenderTransform>
                            <Border CornerRadius="14" ClipToBounds="True">
                                <Grid Loaded="WideCard_Loaded">
                                    <!--
                                        Alinhado ao topo, não ao centro: quando o jogo não tem arte
                                        widescreen, o que entra aqui é a capa vertical recortada, e
                                        é no terço superior dela que ficam o personagem e o logo.
                                        Centralizar cortava justamente essa parte.
                                    -->
                                    <Image Source="{Binding WideArt}" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" />

                                    <!-- Véu inferior: o texto precisa ser legível sobre qualquer arte. -->
                                    <Border VerticalAlignment="Bottom" Height="96">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#CC000000" Offset="0.55" />
                                                <GradientStop Color="#F2000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15.5"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="#C2C6CE" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding PlaytimeText}" Foreground="#C2C6CE" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WideBd" Property="BorderBrush" Value="#4DFFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="WideScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="WideScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="WideScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="WideScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="WideBd" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!--
            Pílula: um botão com rótulo visível, para as escolhas que merecem ser lidas em vez de
            adivinhadas por um ícone. Usada no seletor de perfil, ao lado do Jogar.
        -->
        <Style x:Key="HubPillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource HubText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!--
                            Superfície de vidro: um gradiente muito sutil de branco sobre o fundo
                            escuro, com a borda superior mais clara. É o que separa o botão do plano
                            de fundo sem pintá-lo de uma cor sólida.
                        -->
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#26FFFFFF" Offset="0" />
                                    <GradientStop Color="#14FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0" />
                                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <!-- Respeita o alinhamento pedido pelo botão: na lista de perfis eles
                                 esticam, e sem isso cada item ficava com a largura do próprio texto. -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3DFFFFFF" Offset="0" />
                                            <GradientStop Color="#24FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aba de seção (Todos / Recentes / Favoritos): sublinhado fino em vez de caixa. -->
        <Style x:Key="HubTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="15"
                                       Foreground="{StaticResource HubTextDim}" />
                            <Border x:Name="Underline" Height="2" CornerRadius="1" Margin="0,7,0,0"
                                    Background="{DynamicResource BrandAccentBrush}" Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="UnderlineScale" ScaleX="0.2" />
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource HubText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource HubText}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.2" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Cartão da capa. O item em foco cresce, ganha um anel na cor de destaque e sobe uma
            sombra — três sinais somados, para a seleção ser óbvia a dois metros de distância, que é
            a distância de quem joga com controle.
        -->
        <Style x:Key="HubCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,16,20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Border x:Name="Ring" CornerRadius="10" Margin="-3" BorderThickness="2.5"
                                    BorderBrush="{DynamicResource BrandAccentBrush}" Opacity="0" />

                            <Border x:Name="Card" CornerRadius="8" ClipToBounds="True"
                                    Background="{StaticResource HubSurface}">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CardShadow" BlurRadius="0" ShadowDepth="0"
                                                      Opacity="0" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.17">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.17">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.17" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="30" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Só a capa. O nome aparece no destaque, não sobre cada arte. -->
        <DataTemplate x:Key="HubCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Grid Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  Loaded="GameCard_Loaded">
                <Image Source="{Binding Cover}" Stretch="UniformToFill" />

                <!-- Sem capa: iniciais grandes sobre o fundo do cartão, em vez de um vazio. -->
                <TextBlock Text="{Binding Name}"
                           Visibility="{Binding Cover, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="14" />

                <!-- Faixa com o nome, opcional (Configurações ▸ GameHub). -->
                <Border VerticalAlignment="Bottom" Height="54"
                        Visibility="{Binding DataContext.ShowTitles, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#E6000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" FontWeight="Medium"
                               VerticalAlignment="Bottom" Margin="9,0,9,8"
                               TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap" />
                </Border>

                <Border Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"
                        CornerRadius="9" Padding="5,1" Background="#A6000000">
                    <TextBlock Text="★" Foreground="#FBBF24" FontSize="11" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Fundo próprio do hub, contínuo atrás de tudo -->
    <Grid Background="{StaticResource HubBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= FUNDO DO JOGO EM DESTAQUE ================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" ClipToBounds="True">
            <Image x:Name="HeroImageLayer" Source="{Binding HeroImage}" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="HeroParallax" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect x:Name="HeroBlur" Radius="{Binding HeroBlurRadius}" />
                </Image.Effect>
            </Image>

            <!--
                Duas cortinas sobre a arte. A vertical fecha a imagem antes da grade começar, para
                as capas nunca competirem com o fundo. A horizontal é o que dá a leitura do destaque:
                sólida sob o texto à esquerda, transparente à direita, onde a arte aparece inteira.
            -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#660A0A0C" Offset="0" />
                        <GradientStop Color="#A60A0A0C" Offset="0.38" />
                        <GradientStop Color="#F20A0A0C" Offset="0.62" />
                        <GradientStop Color="#FF0A0A0C" Offset="0.74" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F20A0A0C" Offset="0" />
                        <GradientStop Color="#D90A0A0C" Offset="0.3" />
                        <GradientStop Color="#590A0A0C" Offset="0.62" />
                        <GradientStop Color="#000A0A0C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- ================= CROMO SUPERIOR ================= -->
        <Grid Grid.Row="0" Margin="40,22,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Marca + abas de seção. O logo ancora a tela à esquerda, como num console. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,34,0">
                    <Run Text="PULSE" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubText}" />
                    <Run Text="1X" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BrandAccentBrush}" />
                </TextBlock>

                <RadioButton x:Name="TabAll" Style="{StaticResource HubTab}" GroupName="HubSection"
                             Content="{Binding [GH_AllGames], Source={x:Static loc:Loc.Instance}}"
                             IsChecked="{Binding SectionAll}" />
                <RadioButton Style="{StaticResource HubTab}" GroupName="HubSection"
                             Content="{Binding [GH_Recent], Source={x:Static loc:Loc.Instance}}"
                             IsChecked="{Binding RecentOnly}" />
                <RadioButton Style="{StaticResource HubTab}" GroupName="HubSection"
                             Content="{Binding [GH_Favorites], Source={x:Static loc:Loc.Instance}}"
                             IsChecked="{Binding FavoritesOnly}" />
            </StackPanel>

            <!-- Busca: fina, sem moldura pesada -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="16" Background="#14FFFFFF" Padding="12,0" Margin="0,0,14,0" Width="230">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="SearchBox" Height="32" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource HubText}" CaretBrush="{StaticResource HubText}"
                             VerticalContentAlignment="Center" FontSize="13"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             GotKeyboardFocus="SearchBox_GotFocus" />
                </Grid>
            </Border>

            <!--
                Cromo discreto + estado do sistema. As ações "pesadas" moveram-se para o menu
                lateral (botão View), então aqui fica só o essencial e o relógio/bateria/temperatura,
                como num console.
            -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource HubChromeButton}" Click="AddGames_Click"
                        ToolTip="{Binding [GH_AddTitle], Source={x:Static loc:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding [GH_AddGame], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource HubChromeButton}" Click="OpenMenu_Click"
                        ToolTip="{Binding [GH_MenuTitle], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>

                <!-- Estado do sistema -->
                <Border Width="1" Background="#26FFFFFF" Margin="10,6" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                            Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TemperatureText}" FontSize="12" Foreground="{StaticResource HubTextDim}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BatteryIcon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{Binding BatteryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding BatteryText}" FontSize="12" Foreground="{StaticResource HubTextDim}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </StackPanel>

                <TextBlock Text="{Binding ClockText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource HubText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= DESTAQUE + BIBLIOTECA ================= -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Destaque do jogo selecionado -->
            <Grid x:Name="HeroContent" Grid.Row="0" Margin="40,0,40,26"
                  Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding HeroPlatform}" Foreground="{StaticResource HubTextDim}"
                               FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6"
                               TextOptions.TextFormattingMode="Ideal" />

                    <TextBlock Text="{Binding HeroName}" Foreground="{StaticResource HubText}"
                               FontSize="44" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" MaxHeight="116" LineHeight="50" />

                    <!-- Metadados numa linha só, separados por ponto -->
                    <TextBlock Foreground="{StaticResource HubTextDim}" FontSize="13" Margin="0,10,0,0">
                        <Run Text="{Binding HeroPlaytime, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding HeroLastPlayed, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding HeroProfileName, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Ações: Jogar em destaque, o resto discreto ao lado -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="PlayButton" Click="Play_Click" Cursor="Hand"
                                Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                IsEnabled="{Binding IsLaunching, Converter={StaticResource InvBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PlayBd" CornerRadius="10" Padding="46,16"
                                            BorderThickness="0" BorderBrush="Transparent"
                                            RenderTransformOrigin="0.5,0.5">
                                        <!--
                                            Gradiente vertical claro→escuro no vermelho da marca: dá
                                            volume ao botão sem depender de sombra, que sobre um fundo
                                            escuro quase não aparece.
                                        -->
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F04444" Offset="0" />
                                                <GradientStop Color="#DC2626" Offset="0.55" />
                                                <GradientStop Color="#B01B1B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#DC2626" BlurRadius="22" ShadowDepth="0" Opacity="0.4" />
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="PlayScale" />
                                        </Border.RenderTransform>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding [GH_Play], Source={x:Static loc:Loc.Instance}}"
                                                       Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- O botão Jogar em foco pelo controle ganha um anel claro. -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="PlayBd" Property="BorderThickness" Value="3" />
                                            <Setter TargetName="PlayBd" Property="BorderBrush" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="PlayBd" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Style="{StaticResource HubChromeButton}" Command="{Binding StopSessionCommand}"
                                Padding="26,14" FontSize="14"
                                Content="{Binding [GH_Stop], Source={x:Static loc:Loc.Instance}}"
                                Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVis}}" />

                        <!--
                            O perfil ao lado do Jogar: é a decisão que acompanha "jogar agora", e
                            deixá-la aqui evita procurá-la entre ícones sem rótulo.
                        -->
                        <Button Style="{StaticResource HubPillButton}" Margin="12,0,0,0"
                                Command="{Binding OpenProfilePickerCommand}"
                                ToolTip="{Binding HeroProfileSummary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource BrandAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding [GH_ProfileLabel], Source={x:Static loc:Loc.Instance}}"
                                           VerticalAlignment="Center" Opacity="0.75" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding HeroProfileName}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           VerticalAlignment="Center" Margin="10,1,0,0" Opacity="0.6" />
                            </StackPanel>
                        </Button>

                        <!-- Ações do jogo: agrupadas e separadas do que é "jogar". -->
                        <Border CornerRadius="10" Margin="12,0,0,0" Padding="4" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1FFFFFFF" Offset="0" />
                                    <GradientStop Color="#0FFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2BFFFFFF" Offset="0" />
                                    <GradientStop Color="#0AFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource HubChromeButton}" Padding="13,11"
                                        Click="Statistics_Click"
                                        ToolTip="{Binding [GH_MenuStatistics], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource HubChromeButton}" Padding="13,11"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        ToolTip="{Binding [GH_Favorite], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource HubChromeButton}" Padding="13,11" Click="ChangeCover_Click"
                                        ToolTip="{Binding [GH_ChangeCover], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource HubChromeButton}" Padding="13,11"
                                        Command="{Binding EditGameCommand}"
                                        ToolTip="{Binding [GH_EditGame], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource HubChromeButton}" Padding="13,11"
                                        Command="{Binding RemoveGameCommand}"
                                        ToolTip="{Binding [GH_Remove], Source={x:Static loc:Loc.Instance}}">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--
                        Telemetria do destaque. CPU, GPU e RAM são leitura ao vivo da máquina; o FPS
                        é o médio que ESTE jogo alcançou da última vez — fora de uma partida não há
                        quadros para medir, e um número inventado seria pior que nenhum.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="12.5" />
                            </Style>
                        </StackPanel.Resources>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                                    Visibility="{Binding HasHeroCpu, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CPU" Foreground="{StaticResource HubTextDim}" FontWeight="SemiBold" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding HeroCpuText}" Foreground="{StaticResource HubText}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                                    Visibility="{Binding HasHeroGpu, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GPU" Foreground="{StaticResource HubTextDim}" FontWeight="SemiBold" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding HeroGpuText}" Foreground="{StaticResource HubText}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                                    Visibility="{Binding HasHeroRam, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="RAM" Foreground="{StaticResource HubTextDim}" FontWeight="SemiBold" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding HeroRamText}" Foreground="{StaticResource HubText}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasHeroFps, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding [GH_AvgFpsHint], Source={x:Static loc:Loc.Instance}}">
                            <TextBlock Text="{Binding HeroFpsText}" Foreground="{DynamicResource BrandAccentBrush}"
                                       FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Estado vazio -->
            <TextBlock Grid.Row="0" Text="{Binding EmptyMessage}"
                       Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" FontSize="14"
                       Foreground="{StaticResource HubTextDim}" Margin="40,60"
                       HorizontalAlignment="Center" />

            <!--
                Continuar jogando: os últimos jogos abertos, em cartões largos. É a primeira coisa
                que se procura ao sentar para jogar de novo, e por isso vem antes da grade inteira.
                Um ItemsControl, não um ListBox: os cartões são os mesmos objetos da grade, e duas
                listas com seleção brigariam pelo mesmo item.
            -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="40,0,40,22"
                            Visibility="{Binding HasContinuePlaying, Converter={StaticResource BoolToVis}}">
                    <!-- O título muda com o modo; os três botões trocam o que a faixa mostra. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="{Binding HighlightTitle}" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource HubText}" VerticalAlignment="Center"
                                   Margin="0,0,20,0" />

                        <Border Background="#12FFFFFF" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource HubSegment}" GroupName="HighlightRow"
                                             IsChecked="{Binding HighlightIsRecent, Mode=OneWay}"
                                             Command="{Binding SetHighlightRowCommand}" CommandParameter="recent"
                                             Content="{Binding [GH_Recent], Source={x:Static loc:Loc.Instance}}" />
                                <RadioButton Style="{StaticResource HubSegment}" GroupName="HighlightRow"
                                             IsChecked="{Binding HighlightIsFavorites, Mode=OneWay}"
                                             Command="{Binding SetHighlightRowCommand}" CommandParameter="favorites"
                                             Content="{Binding [GH_Favorites], Source={x:Static loc:Loc.Instance}}" />
                                <RadioButton Style="{StaticResource HubSegment}" GroupName="HighlightRow"
                                             IsChecked="{Binding HighlightIsMostPlayed, Mode=OneWay}"
                                             Command="{Binding SetHighlightRowCommand}" CommandParameter="mostplayed"
                                             Content="{Binding [GH_MostPlayed], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ItemsControl x:Name="HighlightList" ItemsSource="{Binding ContinuePlaying}"
                                  ItemTemplate="{StaticResource HubWideCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Cabeçalho da biblioteca: dá nome à grade e separa-a do que vem acima. -->
                <Grid Grid.Row="1" Margin="40,0,40,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [GH_LibraryTitle], Source={x:Static loc:Loc.Instance}}"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource HubText}" />
                    <TextBlock Grid.Column="1" Text="{Binding LibraryCountText}" FontSize="12"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="12,3,0,0" />
                </Grid>

            <!-- Grade de capas -->
            <ListBox x:Name="LibraryList" Grid.Row="2"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     ItemTemplate="{StaticResource HubCardTemplate}"
                     ItemContainerStyle="{StaticResource HubCard}"
                     Background="Transparent" BorderThickness="0" Padding="40,6,40,10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     MouseDoubleClick="LibraryList_MouseDoubleClick"
                     SizeChanged="LibraryList_SizeChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Centralizado: com o painel encostado à esquerda, sobrava uma faixa
                             vazia grande do lado direito em telas largas. -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            </Grid>
        </Grid>

        <!-- ================= RODAPÉ ================= -->
        <Border Grid.Row="2" Padding="40,12" Background="#B3000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    Estado da máquina em uma linha. O ponto verde é o mesmo sinal de um console
                    pronto para jogar; durante uma varredura ou uma sequência de perfil ele some e
                    o andamento assume o meio do rodapé.
                -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,9,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusyAny, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding [GH_PcReady], Source={x:Static loc:Loc.Instance}}"
                               FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource HubText}"
                               VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding IsBusyAny, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <Border Width="1" Background="#26FFFFFF" Margin="0,2,14,2"
                            Visibility="{Binding IsBusyAny, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding [GH_PcReadyHint], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center"
                               Visibility="{Binding IsBusyAny, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>

                <!-- Andamento da varredura / da sequência do perfil -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,9,0"
                                     Visibility="{Binding IsBusyAny, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding FooterStatus}" FontSize="11.5" Foreground="{StaticResource HubTextDim}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                </StackPanel>

                <!-- Dicas de controle, no estilo das interfaces de console -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding GamepadConnected, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="9" Width="18" Height="18" Background="#16A34A" Margin="0,0,7,0">
                        <TextBlock Text="A" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [GH_Play], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <Border CornerRadius="9" Width="18" Height="18" Background="#DC2626" Margin="0,0,7,0">
                        <TextBlock Text="B" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [Common_Back], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <Border CornerRadius="9" Width="18" Height="18" Background="#2563EB" Margin="0,0,7,0">
                        <TextBlock Text="X" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [GH_Favorite], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <Border CornerRadius="9" Width="18" Height="18" Background="#CA8A04" Margin="0,0,7,0">
                        <TextBlock Text="Y" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [GH_Search], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <Border CornerRadius="4" Width="26" Height="18" Background="#3F4453" Margin="0,0,7,0">
                        <TextBlock Text="View" Foreground="White" FontSize="8" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [GH_MenuTitle], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" />

                    <Border CornerRadius="4" Width="26" Height="18" Background="#3F4453" Margin="18,0,7,0">
                        <TextBlock Text="L2" Foreground="White" FontSize="8" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding [GH_GameActions], Source={x:Static loc:Loc.Instance}}" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Sem controle conectado o canto ficaria vazio; a assinatura ocupa o espaço. -->
                <TextBlock Grid.Column="2" Text="{Binding [GH_Tagline], Source={x:Static loc:Loc.Instance}}"
                           FontSize="10.5" FontWeight="SemiBold" Opacity="0.35"
                           Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center"
                           Visibility="{Binding GamepadConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </Grid>
        </Border>

        <!-- Clarão curto ao iniciar um jogo: retorno imediato enquanto o jogo carrega. -->
        <Rectangle x:Name="LaunchFlash" Grid.Row="0" Grid.RowSpan="3" Fill="White" Opacity="0"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <!--
            ================= ESCOLHA DE PERFIL =================
            Trocar o perfil de um jogo é uma escolha entre poucos itens, então ela acontece aqui
            mesmo, sem abrir o editor. Mudar o que um perfil FAZ continua no editor, alcançável
            pelo último item da lista.
        -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#CC000000"
              Visibility="{Binding IsProfilePickerOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseProfilePickerCommand}" />
            </Grid.InputBindings>

            <Border Background="#F2101114" CornerRadius="14" BorderThickness="1" BorderBrush="#26FFFFFF"
                    Width="430" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="22,20">
                    <TextBlock Text="{Binding [GH_ChooseProfile], Source={x:Static loc:Loc.Instance}}"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource HubText}" />
                    <TextBlock Text="{Binding HeroName}" FontSize="12" Opacity="0.6" Margin="0,3,0,14"
                               Foreground="{StaticResource HubTextDim}" TextTrimming="CharacterEllipsis" />

                    <ItemsControl ItemsSource="{Binding ProfileChoices}" MaxHeight="330">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HubPillButton}" Margin="0,0,10,7"
                                        HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                        Padding="15,12"
                                        Command="{Binding DataContext.ChooseProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource BrandAccentBrush}"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#26FFFFFF" Margin="0,12,0,12" />

                    <Button Style="{StaticResource HubChromeButton}" Padding="12,9"
                            HorizontalAlignment="Left" Command="{Binding EditCurrentProfileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [GH_EditProfileSettings], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= TECLADO VIRTUAL ================= -->
        <Grid x:Name="KeyboardOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#B3000000"
              Visibility="Collapsed">
            <controls:GamepadKeyboard x:Name="VirtualKeyboard" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" MaxWidth="760" />
        </Grid>

        <!-- ================= MENU LATERAL (botão View) ================= -->
        <Grid x:Name="MenuOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <!-- Clicar fora fecha, como em qualquer menu. -->
            <Rectangle Fill="#B3000000" MouseLeftButtonDown="MenuBackdrop_Click" />

            <Border x:Name="MenuPanel" HorizontalAlignment="Left" Width="320" Background="#F2101114"
                    BorderThickness="0,0,1,0" BorderBrush="#26FFFFFF">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuSlide" X="-320" />
                </Border.RenderTransform>

                <Grid Margin="0,26,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,0,24,18">
                        <TextBlock Text="{Binding [GH_MenuTitle], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{StaticResource HubText}" FontSize="19" FontWeight="Bold" />
                        <TextBlock x:Name="MenuSubtitle" Foreground="{StaticResource HubTextDim}" FontSize="12"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ItemsControl x:Name="MenuList" Grid.Row="1" Margin="12,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    FocusVisualStyle nulo de propósito: o anel global do app ficava
                                    POR CIMA do destaque próprio do item, desalinhado com a borda
                                    arredondada e cortado pelo painel — dois indicadores brigando.
                                    Aqui o foco é mostrado só pelo template: barra de acento à
                                    esquerda + fundo levemente aceso.
                                -->
                                <Button Click="MenuItem_Click" Tag="{Binding}" Cursor="Hand" Margin="0,0,0,2"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="0,12,14,12" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Barra de acento: aparece só no item em foco. -->
                                                    <Border x:Name="FocusBar" Grid.Column="0" Width="3" Height="20"
                                                            CornerRadius="2" Margin="5,0,6,0" Opacity="0"
                                                            Background="{DynamicResource BrandAccentBrush}" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Icon}"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                               Foreground="{DynamicResource BrandAccentBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="14"
                                                               Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF" />
                                                    <Setter TargetName="FocusBar" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="2" Margin="24,14,24,0" FontSize="11.5"
                               Foreground="{StaticResource HubTextDim}"
                               Text="{Binding [GH_MenuHint], Source={x:Static loc:Loc.Instance}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
