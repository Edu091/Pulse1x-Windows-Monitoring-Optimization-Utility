<ui:FluentWindow
    x:Class="Pulse1x.App.Views.GameHub.StatisticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels.GameHub"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel}"
    mc:Ignorable="d"
    Title="Pulse1x"
    Height="700"
    Width="940"
    MinHeight="560"
    MinWidth="780"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#0A0A0C"
    WindowStartupLocation="CenterOwner">

    <!-- Tema do GameHub, não o do app: esta janela pertence ao hub. -->
    <ui:FluentWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:RatioToHeightConverter x:Key="RatioToHeight" />

        <SolidColorBrush x:Key="HubText" Color="#F2F3F5" />
        <SolidColorBrush x:Key="HubTextDim" Color="#8B8F98" />
        <SolidColorBrush x:Key="HubSurface" Color="#16171A" />

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HubSurface}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource HubTextDim}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource HubText}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Pulse1x" Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="28,4,28,20">
            <TextBlock Text="{Binding [GH_MenuStatistics], Source={x:Static loc:Loc.Instance}}"
                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource HubText}" />
            <TextBlock Text="{Binding [GH_StatsSubtitle], Source={x:Static loc:Loc.Instance}}"
                       FontSize="12.5" Foreground="{StaticResource HubTextDim}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Resumo geral -->
        <Grid Grid.Row="2" Margin="28,0,16,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding [GH_StatsTotal], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding [GH_StatsPerDay], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding PerDayText}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding [GH_StatsPeak], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding PeakText}" Style="{StaticResource StatValue}" FontSize="15" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding [GH_StatsMostPlayed], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding MostPlayedText}" Style="{StaticResource StatValue}" FontSize="15" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Últimos 14 dias -->
        <Border Grid.Row="3" Background="{StaticResource HubSurface}" CornerRadius="10"
                Margin="28,0,28,20" Padding="18,15">
            <StackPanel>
                <TextBlock Text="{Binding [GH_StatsLast14], Source={x:Static loc:Loc.Instance}}"
                           Style="{StaticResource StatLabel}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding DailyBars}" Height="110">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,0" ToolTip="{Binding ValueText}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- A barra cresce de baixo para cima conforme a proporção do dia. -->
                                <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                        MinHeight="3"
                                        Background="{DynamicResource BrandAccentBrush}">
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource RatioToHeight}">
                                            <Binding Path="Ratio" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.75" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9.5"
                                           Foreground="{StaticResource HubTextDim}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Por jogo -->
        <Grid Grid.Row="4" Margin="28,0,28,0">
            <Border Background="{StaticResource HubSurface}" CornerRadius="10" Padding="0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="18,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding GameName}" FontSize="13.5"
                                               Foreground="{StaticResource HubText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="12.5"
                                               Foreground="{StaticResource HubText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding AverageSessionText}" FontSize="12.5"
                                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SessionCount}" FontSize="12.5"
                                               Foreground="{StaticResource HubTextDim}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource HubTextDim}"
                                               Text="{Binding AverageFps, StringFormat={}{0:0} FPS, TargetNullValue=—}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{Binding [GH_StatsEmpty], Source={x:Static loc:Loc.Instance}}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       Foreground="{StaticResource HubTextDim}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="5" Padding="28,16" Margin="0,18,0,0">
            <Grid>
                <ui:ToggleSwitch HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Content="{Binding [GH_StatsEnabled], Source={x:Static loc:Loc.Instance}}"
                                 Foreground="{StaticResource HubText}"
                                 IsChecked="{Binding MetricsEnabled}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{Binding [GH_StatsClear], Source={x:Static loc:Loc.Instance}}"
                               Command="{Binding ClearHistoryCommand}" Margin="0,0,8,0" Padding="18,7" />
                    <ui:Button Content="{Binding [GH_Close], Source={x:Static loc:Loc.Instance}}"
                               Command="{Binding CloseCommand}" Padding="22,7"
                               Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
