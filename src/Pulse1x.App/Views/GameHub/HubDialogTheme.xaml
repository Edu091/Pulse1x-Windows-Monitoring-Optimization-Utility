<!--
    Paleta compartilhada das janelas de diálogo do GameHub.

    Motivo de existir: os pincéis de controle do Wpf.Ui (ControlFillColor*) são um BRANCO
    TRANSLÚCIDO (#0FFFFFFF). Eles só parecem escuros porque são compostos sobre uma superfície
    escura. Qualquer coisa que mexa no tema, na transparência da personalização ou no acento podia
    deixá-los claros — e então as caixas de combinação e de texto viravam blocos brancos com o
    texto invisível, como aconteceu na janela de perfis.

    Aqui as cores são FIXAS e OPACAS, sem depender do tema do app. Cada janela do hub aplica este
    dicionário e fica imune a essas variações.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <SolidColorBrush x:Key="HubText" Color="#F2F3F5" />
    <SolidColorBrush x:Key="HubTextDim" Color="#9BA0A9" />
    <SolidColorBrush x:Key="HubSurface" Color="#16171A" />
    <SolidColorBrush x:Key="HubStroke" Color="#2A2C31" />
    <SolidColorBrush x:Key="HubField" Color="#1C1D21" />
    <SolidColorBrush x:Key="HubFieldHover" Color="#24262B" />

    <!--
        A lista suspensa de um ComboBox vive num Popup, fora da árvore visual da janela, e por isso
        não herda os pincéis definidos acima: ela resolve as chaves do próprio Wpf.Ui.
        Sobrescrevemos essas chaves AQUI, no dicionário que cada janela do hub aplica — assim o
        Popup as encontra subindo até a janela, sem precisar de um Setter de Resources (que não
        funciona: Resources não é uma propriedade de dependência).
    -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1C1D21" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#24262B" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#2A2C31" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5C8D0" />

    <!--
        Texto DESATIVADO. As seções em "Não alterar" ficam desabilitadas de propósito, mas o tom do
        Wpf.Ui para esse estado é um branco a 36% (#5DFFFFFF) que, sobre o fundo escuro dos campos,
        dava um contraste de cerca de 2:1 — abaixo de qualquer limiar de leitura. O resultado era o
        de um campo "em branco", quando na verdade o conteúdo estava lá, apenas ilegível.
        Estes tons mantêm a distinção visual de desativado, com contraste suficiente para ler.
    -->
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#8E939C" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8E939C" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#8E939C" />
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#8E939C" />
    <SolidColorBrush x:Key="ToggleSwitchContentForegroundDisabled" Color="#8E939C" />
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="#8E939C" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#8E939C" />

    <!--
        Campos desabilitados.

        As chaves do Wpf.Ui para esses estados são brancos translúcidos, e é ISSO que produzia as
        "falhas brancas" nas seções em "Não alterar": medindo o pixel renderizado, a trilha do
        slider saía em RGB(149,149,151) e o campo da caixa de seleção em RGB(142,147,156) — barras
        e blocos claros no meio de uma janela escura. Definidos aqui como tons escuros opacos.
    -->
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#212227" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#212227" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#212227" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#2E3036" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2E3036" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="#3A3D44" />

    <!--
        A trilha do slider é branca a 55% (#8BFFFFFF) MESMO HABILITADA — era a barra branca mais
        evidente da tela. O preenchimento passa a usar a cor de marca e o restante da trilha um
        cinza escuro, como no resto do app.
    -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#3A3D44" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44474F" />
    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#2A2C31" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#DC2626" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#EF4444" />
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#4A2020" />
    <SolidColorBrush x:Key="SliderTickBarFill" Color="#3A3D44" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#DC2626" />
    <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#55585F" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#2A2C31" />
    <SolidColorBrush x:Key="SliderOuterThumbBackgroundDisabled" Color="#2A2C31" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#16171A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#16171A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1C1D21" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#24262B" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!--
        Caixas de seleção: TEMPLATE PRÓPRIO, sem herdar de ninguém.

        Por que não basta um BasedOn, como se tentou antes: o App.xaml declara um estilo implícito
        de ComboBox com BasedOn="{StaticResource {x:Type ComboBox}}" para aplicar o anel de foco.
        Esse StaticResource é resolvido ENQUANTO o dicionário do aplicativo ainda está sendo
        montado — e aí ele podia cair no estilo padrão do WPF (o template claro do sistema) em vez
        do estilo do Wpf.Ui. Esse estilo virava o implícito de todo o app, e este dicionário, ao
        fazer BasedOn no implícito, herdava o template claro junto. Era isso que deixava TODAS as
        caixas de seleção da janela de perfil como blocos cinza-claros de texto invisível
        (medido: RGB(240,240,240) na caixa e RGB(255,255,255) na lista suspensa), enquanto as
        caixas de texto, que usam ui:TextBox e não passam por esse estilo implícito, continuavam
        escuras (RGB(28,29,33)).

        Definindo o template aqui, a aparência não depende mais de qual estilo o BasedOn encontra:
        as cores são as mesmas do resto do hub, em qualquer ordem de carregamento.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
        <Setter Property="Background" Value="{StaticResource HubField}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- O ToggleButton ocupa a caixa inteira: clicar em qualquer ponto abre. -->
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5"
                                            SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Valor selecionado. IsHitTestVisible=False para o clique chegar ao ToggleButton. -->
                        <ContentPresenter x:Name="Content"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />

                        <!-- Campo de edição, usado apenas quando IsEditable="True". -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="{TemplateBinding Padding}"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{StaticResource HubText}"
                                 SelectionBrush="#DC2626"
                                 Style="{x:Null}" />

                        <Path x:Name="Arrow"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{StaticResource HubTextDim}"
                              StrokeThickness="1.4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,11,0"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="True" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <!--
                                A lista vive fora da árvore visual da janela; por isso as cores são
                                escritas aqui, e não herdadas. Sem isto, o Popup resolvia as chaves
                                claras do sistema e aparecia branco.
                            -->
                            <Border Background="{StaticResource HubField}"
                                    BorderBrush="{StaticResource HubStroke}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="Background" Value="{StaticResource HubFieldHover}" />
                        </Trigger>

                        <!-- Desabilitado: escurece o campo, mas mantém o texto legível. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Toggle" Property="Background" Value="#212227" />
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="#2E3036" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="#8E939C" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="#6A6E76" />
                        </Trigger>

                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HubFieldHover}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HubFieldHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#8E939C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
        <Setter Property="Background" Value="{StaticResource HubField}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubStroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource HubText}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
        <Setter Property="Background" Value="{StaticResource HubField}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubStroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource HubText}" />
    </Style>

    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
        <Setter Property="Background" Value="{StaticResource HubField}" />
        <Setter Property="BorderBrush" Value="{StaticResource HubStroke}" />
    </Style>

    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Foreground" Value="{StaticResource HubText}" />
    </Style>
</ResourceDictionary>
