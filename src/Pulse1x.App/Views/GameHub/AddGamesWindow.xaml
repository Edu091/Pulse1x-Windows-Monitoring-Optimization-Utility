<ui:FluentWindow
    x:Class="Pulse1x.App.Views.GameHub.AddGamesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels.GameHub"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:AddGamesViewModel}"
    mc:Ignorable="d"
    Title="Pulse1x"
    Height="600"
    Width="880"
    MinHeight="520"
    MinWidth="760"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#0A0A0C"
    WindowStartupLocation="CenterOwner">

    <!-- Tema do GameHub: esta janela pertence ao hub, não ao app. -->
    <ui:FluentWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:EnumToBooleanConverter x:Key="EnumToBool" />

        <SolidColorBrush x:Key="HubText" Color="#F2F3F5" />
        <SolidColorBrush x:Key="HubTextDim" Color="#8B8F98" />
        <SolidColorBrush x:Key="HubSurface" Color="#16171A" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource HubTextDim}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Um método de adicionar jogos, na lista da esquerda. -->
        <Style x:Key="MethodItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,11" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Top" Margin="0,1,12,0"
                                           Foreground="{DynamicResource BrandAccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource HubText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Pulse1x" Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="24,4,24,16">
            <TextBlock Text="{Binding [GH_AddTitle], Source={x:Static loc:Loc.Instance}}"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource HubText}" />
            <TextBlock Text="{Binding [GH_AddSubtitle], Source={x:Static loc:Loc.Instance}}"
                       FontSize="12.5" Foreground="{StaticResource HubTextDim}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="282" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Métodos -->
            <ListBox Grid.Column="0" Margin="0,0,20,0" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                     ItemContainerStyle="{StaticResource MethodItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <!-- Painel do método escolhido -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedMethod.Description}" TextWrapping="Wrap"
                               FontSize="12.5" Foreground="{StaticResource HubTextDim}" Margin="0,2,0,18" />

                    <!-- Pasta -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMethod}" Value="Folder">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding [GH_AddFolder], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                       Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding BrowseFolderCommand}" />
                        </Grid>
                        <ui:ToggleSwitch Content="{Binding [GH_RememberFolder], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding RememberFolder}" />
                    </StackPanel>

                    <!-- Arquivo -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMethod}" Value="File">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding [GH_Executable], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                       Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding BrowseFileCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding [GH_Name], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [GH_Arguments], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding FileArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [GH_WorkingDirectory], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding FileWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                       Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding BrowseWorkingDirectoryCommand}" />
                        </Grid>

                        <ui:ToggleSwitch Content="{Binding [GH_IsApplication], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding FileIsApplication}" />
                    </StackPanel>

                    <!-- Emulador -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentMethod}" Value="Emulator">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding [GH_ExistingEmulator], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ExistingEmulators}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedExistingEmulator}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [GH_EmulatorName], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding EmulatorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [GH_EmulatorExe], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding EmulatorExecutable, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                       Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding BrowseEmulatorCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding [GH_RomsFolder], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding EmulatorRoms, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                       Content="{Binding [GH_Browse], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding BrowseRomsCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding [GH_Extensions], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding EmulatorExtensions, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [GH_ArgumentsTemplate], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding EmulatorArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [GH_EmulatorPlatform], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding EmulatorPlatform, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Resultado -->
                    <Border Margin="0,18,0,0" CornerRadius="8" Padding="14,11"
                            Background="{StaticResource HubSurface}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource HubText}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Padding="24,14" BorderThickness="0,1,0,0" Margin="0,14,0,0"
                BorderBrush="#26FFFFFF">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,9,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource HubTextDim}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{Binding [GH_Close], Source={x:Static loc:Loc.Instance}}" IsCancel="True"
                               Command="{Binding CloseCommand}" Margin="0,0,8,0" Padding="20,7" />
                    <ui:Button Content="{Binding [GH_AddRun], Source={x:Static loc:Loc.Instance}}" IsDefault="True"
                               Command="{Binding RunCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                               Padding="24,7" Background="{DynamicResource BrandAccentBrush}"
                               Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
