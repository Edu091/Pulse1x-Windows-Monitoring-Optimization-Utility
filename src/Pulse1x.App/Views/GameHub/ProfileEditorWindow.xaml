<ui:FluentWindow
    x:Class="Pulse1x.App.Views.GameHub.ProfileEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels.GameHub"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:ProfileEditorViewModel}"
    mc:Ignorable="d"
    Title="Pulse1x"
    Height="760"
    Width="880"
    MinHeight="560"
    MinWidth="720"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    Background="#0A0A0C"
    Foreground="#F2F3F5"
    WindowStartupLocation="CenterOwner">

    <!--
        Tema próprio do GameHub, como nas demais janelas do hub. Antes esta janela era a única que
        ainda dependia do Mica e dos pincéis de tema do app: quando a transparência da personalização
        reduzia o alfa desses pincéis, os controles apareciam com fundo claro e texto escuro. Fixar a
        paleta aqui elimina essa dependência.
    -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HubDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:ModeIsCustomConverter x:Key="ModeIsCustom" />
        <converters:ModeIsCustomVisibilityConverter x:Key="ModeIsCustomVis" />
        <converters:LocKeyConverter x:Key="LocKey" />

        <!-- Cabeçalho de seção: título grande + o seletor de modo à direita. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource HubText}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource HubTextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!--
            Aviso das seções em "Não alterar" / "Automático". Os campos esmaecidos pareciam
            quebrados; esta linha diz que estão desligados de propósito e como habilitá-los.
        -->
        <Style x:Key="SectionLockedHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource HubTextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HubStroke}" />
            <Setter Property="Background" Value="{StaticResource HubSurface}" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Pulse1x" Grid.Row="0" />

        <!-- Cabeçalho: jogo, nome do perfil e presets -->
        <Border Grid.Row="1" Padding="22,4,22,14">
            <StackPanel>
                <TextBlock Text="{Binding GameName}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding [GH_ProfileEditorTitle], Source={x:Static loc:Loc.Instance}}"
                           FontSize="12" Opacity="0.65" Margin="0,1,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding [GH_ProfileName], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="{Binding [GH_Preset], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PresetCombo" Width="190" Margin="0,3,0,0"
                                  ItemsSource="{Binding Presets}" DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ui:Button Content="{Binding [GH_ApplyPreset], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding ApplyPresetCommand}"
                                   CommandParameter="{Binding SelectedItem, ElementName=PresetCombo}"
                                   Margin="0,0,6,0" />
                        <ui:Button Content="{Binding [GH_SaveAsPreset], Source={x:Static loc:Loc.Instance}}"
                                   Command="{Binding SaveAsPresetCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandAccentBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="22,0,22,8">
            <StackPanel>

                <!-- ============================ ENERGIA ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecPower], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding PowerMode}" />
                        </Grid>

                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding PowerMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding PowerMode, Converter={StaticResource ModeIsCustom}}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [GH_Plan], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PowerPlans}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedPlan}" />
                            </Grid>

                            <ui:ToggleSwitch Content="{Binding [GH_UseUltimate], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding UseUltimate}" Margin="0,0,0,12" />

                            <!-- Configurações avançadas: cada linha é ligada por um interruptor,
                                 porque "não mexer" precisa ser tão fácil quanto definir um valor. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwCpuMin], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding CpuMinEnabled}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CpuMin}" IsEnabled="{Binding CpuMinEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CpuMin, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwCpuMax], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding CpuMaxEnabled}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CpuMax}" IsEnabled="{Binding CpuMaxEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CpuMax, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwBoost], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding BoostEnabled}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding BoostModes}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding BoostMode}" IsEnabled="{Binding BoostEnabled}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwCooling], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding CoolingEnabled}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CoolingPolicies}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding CoolingPolicy}" IsEnabled="{Binding CoolingEnabled}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwPcie], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding PcieEnabled}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PcieStates}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding PcieState}" IsEnabled="{Binding PcieEnabled}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwUsbSuspend], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding UsbSuspendEnabled}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding UsbSuspendStates}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding UsbSuspendState}" IsEnabled="{Binding UsbSuspendEnabled}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwSleep], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SleepEnabled}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding SleepMinutes}" IsEnabled="{Binding SleepEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SleepMinutes}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_PwVideo], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding DisplayOffEnabled}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding DisplayOffMinutes}" IsEnabled="{Binding DisplayOffEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplayOffMinutes}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <ui:Button Content="{Binding [GH_UnhideAdvanced], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding UnhideAdvancedCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ NOTEBOOK / OEM ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecOem], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding OemModeSelection}" />
                        </Grid>

                        <TextBlock Text="{Binding OemVendorText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="220" Margin="0,0,8,0" ItemsSource="{Binding OemModes}"
                                      SelectedItem="{Binding SelectedOemMode}" IsEnabled="{Binding OemAvailable}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LabelKey, Converter={StaticResource LocKey}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button Content="{Binding [GH_DetectOem], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding DetectOemCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ CPU / PROCESSO ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecCpu], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding CpuMode}" />
                        </Grid>

                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding CpuMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding CpuMode, Converter={StaticResource ModeIsCustom}}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [GH_Priority], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Priorities}" DisplayMemberPath="Label" SelectedItem="{Binding Priority}" />
                            </Grid>

                            <ui:ToggleSwitch Content="{Binding [GH_ReserveFirstCore], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding ReserveFirstCore}" Margin="0,0,0,8" />
                            <ui:ToggleSwitch Content="{Binding [GH_CustomAffinity], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding CustomAffinity}" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding Cores}" IsEnabled="{Binding CustomAffinity}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Margin="0,0,12,4" MinWidth="74" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ MEMÓRIA ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecMemory], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding MemoryMode}" />
                        </Grid>
                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding MemoryMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding MemoryMode, Converter={StaticResource ModeIsCustom}}">
                            <ui:ToggleSwitch Content="{Binding [GH_OptimizeBefore], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding OptimizeBefore}" Margin="0,0,0,8" />
                            <ui:ToggleSwitch Content="{Binding [GH_OptimizeAfter], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding OptimizeAfter}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ LATÊNCIA ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecLatency], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding LatencyMode}" />
                        </Grid>
                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding LatencyMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding LatencyMode, Converter={StaticResource ModeIsCustom}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_TimerResolution], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding TimerEnabled}" />
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="15.6" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding TimerMs}" IsEnabled="{Binding TimerEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TimerMs, StringFormat={}{0:0.0} ms}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                            <ui:ToggleSwitch Content="{Binding [GH_DisableUsbSuspend], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding DisableUsbSuspend}" Margin="0,0,0,8" />
                            <ui:ToggleSwitch Content="{Binding [GH_DisableWifiPower], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding DisableWifiPowerSaving}" Margin="0,0,0,8" />
                            <ui:ToggleSwitch Content="{Binding [GH_LowLatency], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding LowLatencyProfile}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ REDE ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecNetwork], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding NetworkMode}" />
                        </Grid>
                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding NetworkMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding NetworkMode, Converter={StaticResource ModeIsCustom}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [GH_NetworkProfile], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding NetworkProfiles}" DisplayMemberPath="Label" SelectedItem="{Binding NetworkProfile}" />
                            </Grid>
                            <ui:ToggleSwitch Content="{Binding [GH_FlushDns], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding FlushDns}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ ÁUDIO ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecAudio], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding AudioMode}" />
                        </Grid>
                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding AudioMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding AudioMode, Converter={StaticResource ModeIsCustom}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_Volume], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding VolumeEnabled}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" IsEnabled="{Binding VolumeEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_Mute], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding MuteEnabled}" />
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Muted}" IsEnabled="{Binding MuteEnabled}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [GH_OutputDevice], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedItem="{Binding OutputDevice}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [GH_InputDevice], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding InputDevices}" DisplayMemberPath="Name" SelectedItem="{Binding InputDevice}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ TELA ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecDisplay], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding DisplayMode}" />
                        </Grid>
                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding DisplayMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding DisplayMode, Converter={StaticResource ModeIsCustom}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [GH_Display], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Displays}" DisplayMemberPath="FriendlyName" SelectedItem="{Binding SelectedDisplay}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_Brightness], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding BrightnessEnabled}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness}" IsEnabled="{Binding BrightnessEnabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0}%}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_RefreshRate], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RefreshRateEnabled}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding RefreshRate}" IsEnabled="{Binding RefreshRateEnabled}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding [GH_Hdr], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding HdrEnabled}" />
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Hdr}" IsEnabled="{Binding HdrEnabled}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ APLICATIVOS ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding [GH_SecApps], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ComboBox HorizontalAlignment="Right" Width="170" ItemsSource="{Binding Modes}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding AppsMode}" />
                        </Grid>

                        <TextBlock Text="{Binding [GH_SectionLocked], Source={x:Static loc:Loc.Instance}}"
                                   Style="{StaticResource SectionLockedHint}"
                                   Visibility="{Binding AppsMode, Converter={StaticResource ModeIsCustomVis}, ConverterParameter=invert}" />

                        <StackPanel IsEnabled="{Binding AppsMode, Converter={StaticResource ModeIsCustom}}">
                            <TextBlock Text="{Binding [GH_CloseBefore], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="True" x:Name="ProcessCombo"
                                          Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                           Content="{Binding [GH_Add], Source={x:Static loc:Loc.Instance}}"
                                           Command="{Binding AddCloseProcessCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CloseProcesses}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <ui:Button Content="✕" HorizontalAlignment="Right" Padding="8,2"
                                                           Command="{Binding DataContext.RemoveCloseProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [GH_StartWith], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ui:Button Content="{Binding [GH_Add], Source={x:Static loc:Loc.Instance}}"
                                       Click="AddStartApp_Click" HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding StartApps}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Path}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ui:Button Grid.Column="1" Content="✕" Padding="8,2"
                                                           Command="{Binding DataContext.RemoveStartAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ui:ToggleSwitch Content="{Binding [GH_ReopenClosed], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding ReopenClosed}" Margin="0,0,0,12" />

                            <TextBlock Text="{Binding [GH_CommandsBefore], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding NewCommandBefore, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{Binding [GH_CommandHint], Source={x:Static loc:Loc.Instance}}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                           Content="{Binding [GH_Add], Source={x:Static loc:Loc.Instance}}"
                                           Command="{Binding AddCommandBeforeCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CommandsBefore}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ui:Button Content="✕" HorizontalAlignment="Right" Padding="8,2"
                                                           Command="{Binding DataContext.RemoveCommandBeforeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [GH_CommandsAfter], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding NewCommandAfter, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{Binding [GH_CommandHint], Source={x:Static loc:Loc.Instance}}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                           Content="{Binding [GH_Add], Source={x:Static loc:Loc.Instance}}"
                                           Command="{Binding AddCommandAfterCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CommandsAfter}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ui:Button Content="✕" HorizontalAlignment="Right" Padding="8,2"
                                                           Command="{Binding DataContext.RemoveCommandAfterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ SEQUÊNCIA ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding [GH_SecSequence], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" />
                            <ui:Button HorizontalAlignment="Right"
                                       Content="{Binding [GH_ResetSteps], Source={x:Static loc:Loc.Instance}}"
                                       Command="{Binding ResetStepsCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding [GH_SequenceHint], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,5" Margin="0,0,0,4"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Order}" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ui:Button Content="▲" Padding="9,2" Margin="0,0,4,0"
                                                           ToolTip="{Binding [GH_MoveUp], Source={x:Static loc:Loc.Instance}}"
                                                           Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content="▼" Padding="9,2"
                                                           ToolTip="{Binding [GH_MoveDown], Source={x:Static loc:Loc.Instance}}"
                                                           Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================ GERAL ============================ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding [GH_SecGeneral], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <ui:ToggleSwitch Content="{Binding [GH_RestoreOnExit], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding RestoreOnExit}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Content="{Binding [GH_GamingMode], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding GamingMode}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="22,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <ui:Button HorizontalAlignment="Left"
                           Content="{Binding [GH_RemoveProfile], Source={x:Static loc:Loc.Instance}}"
                           Command="{Binding RemoveProfileCommand}" Padding="18,7" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="{Binding [GH_Cancel], Source={x:Static loc:Loc.Instance}}" IsCancel="True"
                               Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="20,7" />
                    <ui:Button Content="{Binding [GH_Save], Source={x:Static loc:Loc.Instance}}" IsDefault="True"
                               Command="{Binding SaveCommand}" Padding="24,7"
                               Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
