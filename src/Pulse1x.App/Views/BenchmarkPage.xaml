<Page
    x:Class="Pulse1x.App.Views.BenchmarkPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Pulse1x.App.ViewModels"
    xmlns:converters="clr-namespace:Pulse1x.App.Converters"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=vm:BenchmarkViewModel}"
    mc:Ignorable="d"
    Title="Benchmark">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToBrushConverter x:Key="StrToBrush" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,20">
            <TextBlock Text="{Binding [Bench_PageTitle], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Bench_PageSubtitle], Source={x:Static loc:Loc.Instance}}" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,12" />

            <!-- Resultado geral + ações -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [Bench_Overall], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.6" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding OverallText}" FontSize="40" FontWeight="Bold" />
                            <TextBlock Text="{Binding [Bench_Points], Source={x:Static loc:Loc.Instance}}" FontSize="14" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="6,0,0,9" />
                            <TextBlock Text="{Binding OverallDelta}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="12,0,0,9"
                                       Foreground="{Binding OverallDeltaColor, Converter={StaticResource StrToBrush}}" />
                        </StackPanel>
                        <ProgressBar Value="{Binding OverallBar, Mode=OneWay}" Maximum="1" Height="6" Margin="0,4,0,6" MaxWidth="460" HorizontalAlignment="Left" Width="460" />
                        <TextBlock Text="{Binding OverallDate}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ui:Button Content="{Binding [Bench_RunAll], Source={x:Static loc:Loc.Instance}}" Command="{Binding RunAllCommand}"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Padding="18,10" HorizontalAlignment="Stretch" />
                        <ui:Button Content="{Binding [Bench_Cancel], Source={x:Static loc:Loc.Instance}}" Command="{Binding CancelCommand}"
                                   Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding [Bench_Duration], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.55"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progresso e avisos -->
            <StackPanel Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,0,4" />
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" />
                <TextBlock Text="{Binding [Bench_DontTouch], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.55" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" Margin="0,0,0,10"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            <Border Background="#33F97316" CornerRadius="8" Padding="10,6" Margin="0,0,0,12"
                    Visibility="{Binding BatteryWarning, Converter={StaticResource StrToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Battery424" Foreground="#F97316" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding BatteryWarning}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Cartões das quatro áreas -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BenchmarkCardViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="{Binding [Bench_Run], Source={x:Static loc:Loc.Instance}}" Command="{Binding RunCommand}"
                                               IsEnabled="{Binding CanRun}" Padding="12,4" VerticalAlignment="Top" Margin="8,0,0,0" />
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding ScoreText}" FontSize="28" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DeltaText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                               Foreground="{Binding DeltaColor, Converter={StaticResource StrToBrush}}" />
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,4,0,8">
                                    <ProgressBar Value="{Binding Bar, Mode=OneWay}" Maximum="1" Height="5"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="5" IsIndeterminate="False"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <StackPanel Grid.Row="3">
                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Opacity="0.8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Error}" FontSize="12" Foreground="#F97316" TextWrapping="Wrap"
                                               Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding DeviceText}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DeviceText, Converter={StaticResource StrToVis}}" />
                                    <TextBlock Text="{Binding DateText}" FontSize="11" Opacity="0.45" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Histórico -->
            <Grid Margin="0,8,10,6" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding [Bench_History], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" />
                <ui:Button Content="{Binding [Bench_ClearHistory], Source={x:Static loc:Loc.Instance}}" Command="{Binding ClearHistoryCommand}"
                           HorizontalAlignment="Right" Padding="10,3" FontSize="12" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,10,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,4" Opacity="0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Bench_ColDate], Source={x:Static loc:Loc.Instance}}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding [Bench_ColOverall], Source={x:Static loc:Loc.Instance}}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{Binding [Bench_ColSingle], Source={x:Static loc:Loc.Instance}}" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="{Binding [Bench_ColMulti], Source={x:Static loc:Loc.Instance}}" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="RAM" FontSize="11" />
                        <TextBlock Grid.Column="5" Text="GPU" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BenchmarkHistoryRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}" FontSize="12" Opacity="0.8" />
                                    <TextBlock Grid.Column="1" Text="{Binding Overall}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding CpuSingle}" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{Binding CpuMulti}" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{Binding Memory}" FontSize="12" />
                                    <TextBlock Grid.Column="5" Text="{Binding Gpu}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [Bench_Reference], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,12,10,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
