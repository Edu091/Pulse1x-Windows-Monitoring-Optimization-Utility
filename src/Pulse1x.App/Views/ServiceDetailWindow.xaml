<ui:FluentWindow
    x:Class="Pulse1x.App.Views.ServiceDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    Title="Pulse1x"
    Height="440"
    Width="460"
    MinHeight="320"
    MinWidth="380"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Pulse1x" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,8">
            <StackPanel>
                <!-- Cabeçalho: empresa + serviço -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="IconText" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CompanyText" FontSize="13" Opacity="0.65" />
                        <TextBlock x:Name="ServiceText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- Status atual -->
                <Border CornerRadius="10" Padding="14,10" Margin="0,10,0,0" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Srv_DetailStatus], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Detalhes do incidente (ou aviso de indisponível) -->
                <StackPanel x:Name="IncidentPanel" Margin="0,12,0,0">
                    <TextBlock x:Name="AffectedLabel" Text="{Binding [Srv_DetailAffected], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.6" />
                    <TextBlock x:Name="AffectedText" TextWrapping="Wrap" Margin="0,1,0,8" />

                    <TextBlock x:Name="RegionsLabel" Text="{Binding [Srv_DetailRegions], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.6" />
                    <TextBlock x:Name="RegionsText" TextWrapping="Wrap" Margin="0,1,0,8" />

                    <TextBlock x:Name="StartedLabel" Text="{Binding [Srv_DetailStarted], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.6" />
                    <TextBlock x:Name="StartedText" Margin="0,1,0,8" />

                    <TextBlock x:Name="UpdatedLabel" Text="{Binding [Srv_DetailUpdated], Source={x:Static loc:Loc.Instance}}" FontSize="11" Opacity="0.6" />
                    <TextBlock x:Name="UpdatedText" Margin="0,1,0,8" />

                    <TextBlock x:Name="LatestText" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock x:Name="NoteText" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
            <ui:Button x:Name="OpenPageButton" Click="OpenPageButton_Click"
                       Content="{Binding [Srv_DetailOpenPage], Source={x:Static loc:Loc.Instance}}"
                       Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold" />
            <ui:Button x:Name="CloseButton" Click="CloseButton_Click" Margin="8,0,0,0"
                       Content="{Binding [Srv_DetailClose], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
