<Page
    x:Class="Pulse1x.App.Views.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Pulse1x.App.Localization"
    Title="Buy me a coffee">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="520" HorizontalAlignment="Center">
            <TextBlock Text="☕" FontSize="44" HorizontalAlignment="Center" Margin="0,8,0,4" />
            <TextBlock Text="{Binding [Donate_Title], Source={x:Static loc:Loc.Instance}}"
                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />

            <TextBlock Text="{Binding [Donate_Message], Source={x:Static loc:Loc.Instance}}"
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85" FontSize="14"
                       LineHeight="22" Margin="0,18,0,8" />
            <TextBlock Text="{Binding [Donate_Thanks], Source={x:Static loc:Loc.Instance}}"
                       FontStyle="Italic" FontWeight="SemiBold" TextAlignment="Center"
                       Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,0,22" />

            <!-- Doação: link/chave Pix voluntária. Sem processamento de pagamento dentro do app —
                 só copia a chave; o usuário paga pelo próprio app do banco. -->
            <Border CornerRadius="14" Padding="20" BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding [Donate_PixKeyLabel], Source={x:Static loc:Loc.Instance}}"
                               FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" Padding="10,9" Margin="0,0,8,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock x:Name="PixKeyText" FontFamily="Consolas" FontSize="13"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ui:Button Grid.Column="1" Click="CopyPixKey_Click"
                                   Background="{DynamicResource BrandAccentBrush}" Foreground="White" FontWeight="SemiBold"
                                   Content="{Binding [Donate_CopyKey], Source={x:Static loc:Loc.Instance}}" />
                    </Grid>
                    <TextBlock x:Name="CopiedFeedback" Text="{Binding [Donate_Copied], Source={x:Static loc:Loc.Instance}}"
                               Foreground="#22C55E" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
