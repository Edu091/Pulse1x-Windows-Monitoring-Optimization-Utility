<Application x:Class="Pulse1x.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pulse1x.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- O modo padrão do Pulse1x é escuro. O ApplicationThemeManager ainda alterna
                     para claro nas Configurações, mas iniciar pelo dicionário claro deixava os
                     pincéis de texto pretos até a primeira troca de tema. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cor de marca do Pulse1x (vermelho). Definida como recurso explícito para que
                 barras de progresso e quaisquer elementos personalizados usem exatamente o mesmo
                 tom dos botões/acento do app, sem depender de chaves internas do Wpf.Ui. -->
            <!--
                Indicador de foco de TODA a interface. O WPF só desenha o "focus visual" quando a
                navegação veio do teclado, e o padrão dele é um tracejado fino que some sobre fundos
                escuros. Com um controle na mão, saber onde está o seletor é essencial — então aqui
                ele vira um anel na cor de marca, aplicado a todos os controles do app (inclusive
                nas janelas de Adicionar jogos, Perfil e Estatísticas).
            -->
            <Style x:Key="GamepadFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" RadiusX="7" RadiusY="7"
                                       Stroke="{DynamicResource BrandAccentBrush}" StrokeThickness="2.5"
                                       SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Aplica o indicador a todos os tipos de controle interativos. -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource GamepadFocusVisual}" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource GamepadFocusVisual}" />
            </Style>
            <!-- O Foreground aqui não é decorativo: dentro de um DataTemplate (ex.: a lista de
                 launchers nas Configurações, as opções do editor de perfil) o texto do CheckBox
                 não herdava o pincel do tema e saía no PRETO padrão do sistema, ilegível sobre o
                 fundo escuro. Fixá-lo no pincel do tema resolve em todas as telas de uma vez. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource GamepadFocusVisual}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource GamepadFocusVisual}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource GamepadFocusVisual}" />
            </Style>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource GamepadFocusVisual}" />
            </Style>

            <!--
                Deslizantes. A trilha do Wpf.Ui é branca a 55% (#8BFFFFFF) mesmo habilitada, o que
                deixava barras claras atravessando as telas escuras (era o que aparecia na
                configuração de perfis e também nas Configurações). O preenchimento segue a cor de
                marca e o restante da trilha fica em cinza escuro.
            -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#3A3D44" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44474F" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#2A2C31" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#DC2626" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#EF4444" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#4A2020" />
            <SolidColorBrush x:Key="SliderTickBarFill" Color="#3A3D44" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#DC2626" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#55585F" />

            <Color x:Key="BrandAccentColor">#DC2626</Color>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="BrandHighlightBrush" Color="#F87171" />

            <!-- Os botões "Appearance=Primary" do Wpf.Ui (e outros controles em destaque) não
                 seguem o SystemAccentColor trocado em App.xaml.cs — eles leem estas chaves
                 "AccentFillColor*" do tema diretamente. Sobrescrevemos aqui para que também
                 fiquem vermelhos, com tons mais escuros para hover/pressed. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#991B1B" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#991B1B" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="White" />

            <!-- A barra de rolagem (scrollbar) do Wpf.Ui usa estas chaves para o "polegar"
                 que se arrasta. Sobrescritas para vermelho, mantendo o padrão de marca. -->
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#DC2626" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#B91C1C" />

            <!-- O ToggleSwitch (interruptor) do Wpf.Ui usa estas chaves para a trilha/contorno
                 quando ligado — seguem o padrão de marca em vez do azul do SystemAccentColor. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#DC2626" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#B91C1C" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#991B1B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#DC2626" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#B91C1C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#991B1B" />

            <!-- O ProgressBar nativo do WPF não é restilizado pelo Wpf.Ui e usa o azul
                 padrão do Windows (Aero2). Este template substitui a barra de progresso
                 por uma versão simples cujo preenchimento segue a cor de marca do app,
                 mantendo o padrão vermelho em todas as categorias. -->
            <!-- ToggleButton de marca: o ToggleButton padrão do WPF fica AZUL (Aero) quando
                 marcado. Este template autocontido usa o vermelho do app no estado "checked"
                 (texto branco), com fundo temático/borda quando desmarcado e estados de hover.
                 Aplicado por chave (ex.: botão Personalizar e os toggles 👁 do Dashboard). -->
            <Style x:Key="BrandToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="6" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandAccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSecondaryBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost: cabeçalhos recolhíveis (chevron) que eram ToggleButton padrão e ficavam
                 AZUIS quando expandidos. Transparente, SEM preenchimento no "checked" (o estado é
                 indicado pelo próprio chevron ⌄/⌃), com hover sutil. Aplicado por chave aos
                 cabeçalhos de seção/explicação. NÃO é implícito de propósito: um estilo global de
                 ToggleButton quebraria o ComboBox (que usa um ToggleButton interno). -->
            <Style x:Key="GhostToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="8" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border
                                    x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                                <Border
                                    x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- O Expander é o único controle nativo que o Wpf.Ui não restiliza, então ele caía no
                 tema Aero do Windows: cabeçalho claro com texto PRETO, ilegível sobre o fundo
                 escuro do app (aparecia assim nas Configurações). Este template segue o mesmo
                 caminho já usado no ProgressBar e nos ToggleButton de marca — autocontido e
                 inteiramente baseado nos pincéis do tema, de modo que o texto acompanha o
                 TextFillColorPrimaryBrush no escuro e no claro. O chevron ⌄/⌃ indica o estado,
                 como nos demais cabeçalhos recolhíveis do app. -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border CornerRadius="8" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="ContentRow" Height="0" />
                                    </Grid.RowDefinitions>

                                    <ToggleButton x:Name="HeaderSite" Grid.Row="0"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                  HorizontalContentAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderBd" Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="12,10" SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                          ContentSource="Content"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                                        <TextBlock x:Name="Chevron" Grid.Column="1" Text="⌄"
                                                                   FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   Foreground="{TemplateBinding Foreground}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="Text" Value="⌃" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    </ToggleButton>

                                    <ContentPresenter x:Name="ExpandSite" Grid.Row="1"
                                                      Margin="{TemplateBinding Padding}"
                                                      Visibility="Collapsed"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ContentRow" Property="Height" Value="Auto" />
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
